#!/usr/bin/env -S bash -euo pipefail
#MISE description = "Serve a pull request its baked delta baseline, or bake one in place when the restored stage is stale"

parent="${PARENT:?}"
restored="${RESTORED:-}"
stage="${STAGE:?}"
tree="$RUNNER_TEMP/parent"

git fetch --depth=1 -q origin "$parent"

if [[ -n "$restored" ]] \
  && git diff --quiet "$parent" HEAD -- .mise/lib .mise/tasks/rust/bake; then
  baked="${restored##*-}"
  if [[ "$baked" == "$parent" ]] \
    || { git fetch --depth=1 -q origin "$baked" \
      && git diff --quiet "$baked" "$parent" -- \
        .mise/config.toml .mise/lib .mise/tasks/rust/bake \
        Cargo.lock Cargo.toml crate/Cargo.toml crate/src; }; then
    printf 'the stage baked at %s serves %s\n' "$baked" "$parent"
    exit 0
  fi
fi
rm -rf "$stage"

git worktree add -q "$tree" "$parent"
CARGO_TARGET_DIR="$PWD/target" PROSE_DELTA_BASELINE="$tree" PROSE_DELTA_STAGE="$stage" \
  mise run rust:bake

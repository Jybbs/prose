#!/usr/bin/env -S uv run --script
#MISE description="Render a workflow step summary and exit with its gate verdict"
# /// script
# requires-python = ">=3.11"
# dependencies = ["jinja2==3.1.6", "pyyaml==6.0.3"]
# ///
"""
Render a Prose step summary and gate the workflow's exit code.

Subcommands:
    ci       Render the CI gate summary. Reads `CHECK` plus the
             GitHub-runner defaults. Exits 0 when `CHECK` is success.
    corpus   Render the Corpus gate summary. Reads the result of every
             job the corpus workflow's gate depends on, each under its
             upper-cased job id, plus `ARMED` for whether the imports
             ratchet read a baked break set, plus the GitHub-runner
             defaults. Exits 0 when every one of them that ran is a
             success, the delta reporting without gating and an unarmed
             ratchet degrading the summary without failing it.
    deploy   Render the Deploy gate summary. Reads `CHECKS`, `PRESS`,
             `DEPLOY`, and `URL` plus the GitHub-runner defaults. Exits
             0 when every one of them is success.
    draft    Render the Draft summary. Reads `DRAFT_STATE`,
             `DRAFT_URL`, and `VERSION`, plus the GitHub-runner
             defaults.
    release  Render the Release gate summary. Reads `BUILD`, `SDIST`,
             `VALIDATE`, `PUBLISH`, plus the GitHub-runner defaults.
             Exits 0 when every required job succeeded. `PUBLISH` is
             required only on tag runs.
    warm     Render the Warm gate summary. Reads `CHECKS` and `WHEELS`
             plus the GitHub-runner defaults. Exits 0 when both are
             success.

Each subcommand renders into `$GITHUB_STEP_SUMMARY` when it is set,
stdout otherwise.
"""

from jinja2  import Environment, FileSystemLoader
from os      import environ
from pathlib import Path
from sys     import argv
from tomllib import loads
from yaml    import safe_load

DELTA   = "delta"
IMPORTS = "imports"


def failed(*signals: str) -> bool:
    """
    Report whether any of the `signals` env vars is not a success.
    """
    return any(environ[signal] != "success" for signal in signals)


class Summary:
    """
    Render a Prose workflow step summary.
    """

    def __init__(self):
        self.here = Path(".github/scripts")

        ref  = environ["REF"]
        repo = environ["GITHUB_REPOSITORY"]
        sha  = environ["SHA"]
        base = f"{environ['GITHUB_SERVER_URL']}/{repo}"

        self.is_tag = environ.get("GITHUB_REF_TYPE") == "tag"
        self.env    = Environment(
            keep_trailing_newline = True,
            loader                = FileSystemLoader(self.here / "templates"),
            lstrip_blocks         = True,
            trim_blocks           = True
        )
        self.env.globals.update(
            codecov_url = f"https://app.codecov.io/gh/{repo}/commit/{sha}",
            commit_link = f"[`{sha[:7]}`]({base}/commit/{sha})",
            is_tag      = self.is_tag,
            pypi_url    = f"https://pypi.org/project/prose-formatter/{ref}/",
            ref         = ref,
            tag_link    = f"[`{ref}`]({base}/releases/tag/{ref})"
        )

    def _emit(self, name: str, **context):
        """
        Render the `name` template into `$GITHUB_STEP_SUMMARY`, or to
        stdout when it is unset.
        """
        text = self.env.get_template(f"{name}-summary.md.j2").render(**context)

        if path := environ.get("GITHUB_STEP_SUMMARY"):
            with open(path, "a", encoding="utf-8") as f:
                f.write(text)
        else:
            print(text, end = "")

    def _gate(self, name: str, *signals: str, degraded: bool = False, **context):
        """
        Render the `name` template and exit with the verdict of the
        `signals` env vars. A degraded run passes and says so, its
        headline reading the way its rows do.
        """
        verdict = failed(*signals)
        mark    = "❌" if verdict else "⚠️" if degraded else "✅"

        self._emit(name, check_mark = mark, **context)
        raise SystemExit(verdict)

    @staticmethod
    def _row(jobs: dict, job: str) -> dict:
        """
        The mark and the name one corpus row shows, the imports row
        reading as unarmed where it succeeded against no baked baseline.

        Args:
            jobs : The workflow's job table.
            job  : The job id whose row to build.
        """
        result = environ[job.upper()]
        name   = jobs[job]["name"].split("${{")[0].strip() or job.capitalize()

        if job == IMPORTS and result == "success" and environ.get("ARMED") != "true":
            return {"mark": "⚠️", "name": f"{name} (no baked baseline, nothing asserted)"}

        return {"mark": {"skipped": "➖", "success": "✅"}.get(result, "❌"), "name": name}

    def ci(self):
        """
        Render the CI gate summary and exit with the matrix verdict.
        """
        self._gate("ci", "CHECK")

    def corpus(self):
        """
        Render the Corpus gate summary and exit with the verdict of every
        job the workflow's gate depends on, read off the workflow itself,
        the delta reporting without gating.
        """
        jobs   = safe_load(Path(".github/workflows/corpus.yml").read_text(encoding="utf-8"))["jobs"]
        needed = jobs["gate"]["needs"]
        sweeps = [self._row(jobs, job) for job in needed]

        self._gate(
            "corpus",
            *[job.upper() for job in needed if job != DELTA and environ[job.upper()] != "skipped"],
            degraded = any(row["mark"] == "⚠️" for row in sweeps),
            sweeps   = sweeps
        )

    def deploy(self):
        """
        Render the Deploy gate summary and exit with the deploy verdict.
        """
        stages = {
            "CHECKS" : "Checks",
            "PRESS"  : "Press",
            "DEPLOY" : "Publish"
        }

        self._gate(
            "deploy", *stages,
            stage = next((s for k, s in stages.items() if failed(k)), ""),
            url   = environ.get("URL", "")
        )

    def draft(self):
        """
        Render the Draft summary across the cut, existing, and no-op states.
        """
        self._emit(
            "draft",
            draft_url = environ.get("DRAFT_URL", ""),
            state     = environ.get("DRAFT_STATE", ""),
            version   = environ["VERSION"]
        )

    def release(self):
        """
        Render the Release gate summary and exit with the pipeline verdict.
        """
        artifacts = [
            {
                "label"  : p["label"],
                "mark"   : "✅" if path else "❌",
                "target" : f"`{p['target']}`" if p.get("target") else "—"
            }
            for p in loads((self.here / "platforms.toml").read_text())["platforms"]
            for path in [next(Path("dist").glob(p["pattern"]), None)]
        ]

        prepub_failed = failed("BUILD", "SDIST", "VALIDATE")
        published     = not failed("PUBLISH")

        self._emit(
            "release",
            platforms     = artifacts,
            prepub_failed = prepub_failed,
            published     = published
        )

        raise SystemExit(prepub_failed or self.is_tag and not published)

    def warm(self):
        """
        Render the Warm gate summary and exit with the cache-warm verdict.
        """
        self._gate("warm", "CHECKS", "WHEELS")


if __name__ == "__main__":

    if (cmd := argv[1]) not in {n for n in vars(Summary) if not n.startswith("_")}:
        raise SystemExit(f"unknown subcommand: {cmd}")
    getattr(Summary(), cmd)()

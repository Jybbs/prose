#!/usr/bin/env -S uv run --script
#MISE description="Emit a workflow matrix, the wheel build on a verified release or the corpus subset probe"
# /// script
# requires-python = ">=3.11"
# dependencies = ["pyyaml==6.0.3"]
# ///
"""
Plan a workflow run, emitting the matrix its jobs fan out over.

Bare, plans a wheel run. On a tag run, exits nonzero with an `::error::`
unless `crate/Cargo.toml` carries the tag's version. Reads
`.github/scripts/platforms.toml`, keeps the entries that carry a `runner`
(every wheel row does, the sdist row does not), drops the fields no
matrix row consumes (`label`, `pattern`, `smoke`), and emits
`matrix=<json>` plus `smoke=wheels-<name>`, naming the artifact the
release validate job installs.

With `corpus`, plans the subset probe. Reads `BASE` and
`GITHUB_EVENT_NAME`. A push run, and a pull request changing anything
the corpus workflow watches other than a registered rule's module, take
the full probe as one row per rule family carrying the family's rules.
A pull request whose watched changes all sit under
`crate/src/rules/<module>/` takes one row per family those rules belong
to, scoped to them through `PROSE_SETTLE_RULES`. A row is named by its
family's badge and label, read off the docs site's `FAMILY_META`, with
membership read off the rule pages under `site/rules/<family>/`.

Lines land in `$GITHUB_OUTPUT` when it is set, stdout otherwise.
"""

from fnmatch    import fnmatch
from json       import dumps
from os         import environ
from pathlib    import Path
from re         import MULTILINE, finditer
from subprocess import run
from sys        import argv
from tomllib    import loads
from yaml       import safe_load

FAMILY_META_ENTRY = r"^\s*(?P<family>\w+)\s*:\s*\{ badge: '(?P<badge>[^']+)', label: '(?P<label>[^']+)'"


def badges() -> dict[str, tuple[str, str]]:
    """
    Map each family to its badge and label, read off `FAMILY_META` in
    the docs site's shared registry.
    """
    source = Path("site/.vitepress/lib/shared/registries.ts").read_text(encoding="utf-8")
    return {m["family"]: (m["badge"], m["label"]) for m in finditer(FAMILY_META_ENTRY, source, MULTILINE)}


def changed() -> list[str]:
    """
    Return the paths the checked-out merge changes against `BASE`.
    """
    base = environ["BASE"]
    run(["git", "fetch", "--depth=1", "-q", "origin", base], check=True)
    diff = run(["git", "diff", "--name-only", base, "HEAD"], capture_output=True, check=True, text=True)
    return diff.stdout.split()


def corpus():
    """
    Emit the subset probe's matrix, one row per rule family, scoped to
    the rules a pull request touches or carrying the whole family. A run
    carrying whole families partitions the rules, so each row claims the
    pairs its own family opens and no pair is probed twice.
    """
    slugs   = [] if environ.get("GITHUB_EVENT_NAME") == "push" else scoped(changed())
    meta    = badges()
    catalog = families()
    rows    = []

    if unnamed := catalog.keys() - meta.keys():
        raise SystemExit(f"::error::FAMILY_META carries no badge for {', '.join(sorted(unnamed))}")

    for family, members in catalog.items():
        held = [slug for slug in members if slug in slugs] if slugs else members
        if held:
            badge, label = meta[family]
            rows.append({
                "label": f"{badge} Subsets · {label}",
                "pairs": "touching" if slugs else "owned",
                "rules": " ".join(held),
            })
    emit(f"matrix={dumps({'include': rows}, ensure_ascii=False)}")


def emit(*lines: str):
    """
    Append `lines` to `$GITHUB_OUTPUT`, or print them when it is unset.
    """
    if path := environ.get("GITHUB_OUTPUT"):
        with open(path, "a", encoding="utf-8") as f:
            f.writelines(f"{line}\n" for line in lines)
    else:
        print("\n".join(lines))


def families() -> dict[str, list[str]]:
    """
    Map each rule family to its registered slugs, read off the rule pages
    under `site/rules/<family>/`, failing on a registered rule no page
    places.
    """
    known = set(registry().values())
    pages = {
        d.name: sorted(p.stem for p in d.glob("*.md") if p.stem in known)
        for d in sorted(Path("site/rules").iterdir()) if d.is_dir()
    }
    if unplaced := known - {slug for slugs in pages.values() for slug in slugs}:
        raise SystemExit(f"::error::no page under site/rules/<family>/ places {', '.join(sorted(unplaced))}")
    return {family: slugs for family, slugs in pages.items() if slugs}


def registry() -> dict[str, str]:
    """
    Map each rule module directory to its slug, the directory's name with
    `_` read as `-`.
    """
    return {d.name: d.name.replace("_", "-") for d in Path("crate/src/rules").iterdir() if d.is_dir()}


def scoped(paths: list[str]) -> list[str]:
    """
    Return the slugs of the rule modules `paths` touch, empty when a
    path the corpus workflow watches sits outside a registered rule's
    module.
    """
    globs   = watched()
    modules = registry()
    slugs   = set()
    for path in paths:
        if not any(fnmatch(path, glob) for glob in globs):
            continue
        parts = path.split("/")
        if parts[:3] != ["crate", "src", "rules"] or len(parts) < 5 or parts[3] not in modules:
            return []
        slugs.add(modules[parts[3]])
    return sorted(slugs)


def verify_tag():
    """
    Exit nonzero when a tag run's `crate/Cargo.toml` disagrees with the tag.
    """
    if environ.get("GITHUB_REF_TYPE") != "tag":
        return

    expected = environ["GITHUB_REF_NAME"]
    actual   = loads(Path("crate/Cargo.toml").read_text())["package"]["version"]

    if actual != expected:
        raise SystemExit(
            f"::error::crate/Cargo.toml version mismatch: "
            f"expected {expected}, got {actual}"
        )


def watched() -> list[str]:
    """
    The path globs the corpus workflow's pull-request trigger filters on.
    """
    triggers = safe_load(Path(".github/workflows/corpus.yml").read_text(encoding="utf-8"))
    return triggers.get("on", triggers.get(True))["pull_request"]["paths"]


def wheels():
    """
    Verify a tagged release and emit the wheel build matrix.
    """
    verify_tag()

    platforms = loads(Path(".github/scripts/platforms.toml").read_text())["platforms"]
    include   = [
        {k: v for k, v in p.items() if k not in {"label", "pattern", "smoke"}}
        for p in platforms if "runner" in p
    ]
    smoke = next(p["name"] for p in platforms if p.get("smoke"))

    emit(
        f"matrix={dumps({'include': include})}",
        f"smoke=wheels-{smoke}"
    )


if __name__ == "__main__":

    corpus() if argv[1:] == ["corpus"] else wheels()

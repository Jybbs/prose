#!/usr/bin/env -S bash -euo pipefail
#MISE description = "Drop every cache under PREFIX except the one keyed to the current commit"

export KEPT="${PREFIX:?}$GITHUB_SHA"

gh api \
  --jq '.actions_caches[]
        | select(.key | startswith(env.PREFIX))
        | select(.key != env.KEPT)
        | .id' \
  --paginate \
  "repos/$GITHUB_REPOSITORY/actions/caches?per_page=100" \
  | xargs -r -I {} gh api --method DELETE "repos/$GITHUB_REPOSITORY/actions/caches/{}"

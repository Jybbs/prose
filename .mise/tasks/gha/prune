#!/usr/bin/env -S bash -euo pipefail
#MISE description = "Group the caches by key prefix and delete every entry but the newest in each group"

endpoint="repos/$GITHUB_REPOSITORY/actions/caches"

superseded=$(gh api --jq '.actions_caches[]' --paginate "$endpoint?per_page=100" \
  | jq -rs '
  def generation:
    (if startswith("v0-rust-") then -2 else -1 end) as $drop
    | split("-")
    | .[:$drop]
    | join("-");
  map(select(.key | index("-")))
  | group_by(.key | generation)
  | map(sort_by(.created_at)[:-1])
  | add // []
  | .[]
  | [.id, .key, .size_in_bytes]
  | @tsv')

if [[ -z "$superseded" ]]; then
  echo "each key prefix holds a single entry, so there is nothing to delete"
  exit 0
fi

reclaimed=0

while IFS=$'\t' read -r id key bytes; do
  printf 'deleting %s, %s bytes\n' "$key" "$bytes"
  gh api --method DELETE "$endpoint/$id"
  reclaimed=$(( reclaimed + bytes ))
done <<< "$superseded"

printf '\n%s bytes reclaimed\n' "$reclaimed"

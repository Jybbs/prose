#!/usr/bin/env -S bash -euo pipefail
#MISE description="Check the built site's off-site URLs with `lychee`"
#MISE dir="site"
#MISE depends=["press"]
#MISE tools={"aqua:lycheeverse/lychee" = "0.24.2"}

SITE_HOST=$(grep -om1 'https://[^/<]*' dist/sitemap-index.xml | cut -d/ -f3)

lychee --no-progress \
  --max-retries 3 --retry-wait-time 2 --timeout 30 \
  --cache --max-cache-age 1d --cache-exclude-status '429, 500..504' \
  --base-url "https://${SITE_HOST}" \
  --exclude "^https?://(www\.)?${SITE_HOST//./\\.}" \
  --exclude '^https://github\.com/Jybbs/prose/edit/' \
  dist

#!/usr/bin/env -S bash -euo pipefail
#MISE description="Run the linters including `clippy`, passing `rust` or `site` to scope"

lint_rust() {
  cargo clippy --all-targets --locked -- -D warnings
}

lint_site() {
  cd site
  bun install --frozen-lockfile
  bunx --bun oxlint src
  bunx --bun eslint .
}

case "${1:-all}" in
  all)  lint_rust && (lint_site) ;;
  rust) lint_rust ;;
  site) (lint_site) ;;
  *)    echo "usage: mise lint [rust|site]" >&2; exit 2 ;;
esac

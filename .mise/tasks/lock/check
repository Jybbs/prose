#!/usr/bin/env -S bash -euo pipefail
#MISE alias       = "lockfile"
#MISE description = "Verify every lockfile is in sync with its manifest"
#MISE sources     = [
#MISE   ".mise/config.toml",
#MISE   ".mise/mise.lock",
#MISE   "Cargo.lock",
#MISE   "Cargo.toml",
#MISE   "corpus/Cargo.toml",
#MISE   "crate/Cargo.toml",
#MISE   "crate/pyproject.toml",
#MISE   "crate/uv.lock",
#MISE   "site/bun.lock",
#MISE   "site/package.json",
#MISE   "wasm/Cargo.toml"
#MISE ]

(cd site && bun install --dry-run --frozen-lockfile)
cargo update --dry-run --locked --workspace
stale=$(mise lock --dry-run --json)
[[ "$stale" == "[]" ]] || { echo "$stale" >&2; exit 1; }
uv lock --locked --project crate

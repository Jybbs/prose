#!/usr/bin/env -S bash -euo pipefail
#MISE alias       = "lockfile"
#MISE description = "Verify every lockfile is in sync with its manifest"
#MISE sources     = [
#MISE   "@group:manifests",
#MISE   ".mise/mise.lock",
#MISE   "Cargo.lock",
#MISE   "crate/uv.lock",
#MISE   "site/bun.lock"
#MISE ]

(cd site && bun install --dry-run --frozen-lockfile)
cargo update --dry-run --locked --workspace
snapshot=$(mktemp)
trap 'rm -f "$snapshot"' EXIT
cp .mise/mise.lock "$snapshot"
mise lock --quiet
diff -u "$snapshot" .mise/mise.lock >&2 || {
  mv "$snapshot" .mise/mise.lock
  exit 1
}
MISE_LOCKED_SCOPES=project mise install --dry-run --force --locked
uv lock --check --project crate

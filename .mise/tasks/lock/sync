#!/usr/bin/env -S bash -euo pipefail
#MISE alias       = "relock"
#MISE description = "Re-resolve every lockfile against its manifest"
#MISE outputs     = [
#MISE   ".mise/locks/**/*",
#MISE   ".mise/mise.lock",
#MISE   "Cargo.lock",
#MISE   "crate/uv.lock",
#MISE   "site/bun.lock"
#MISE ]
#MISE sources     = ["@group:manifests"]

(cd site && bun install --lockfile-only)
cargo update --workspace
mise lock
uv lock --project crate
mise task info --json lock:sync | jq -r '.outputs[]' | xargs git status --short --

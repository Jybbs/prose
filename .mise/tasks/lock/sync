#!/usr/bin/env -S bash -euo pipefail
#MISE alias       = "relock"
#MISE description = "Re-resolve every lockfile against its manifest"
#MISE outputs     = [".mise/mise.lock", "Cargo.lock", "crate/uv.lock", "site/bun.lock"]
#MISE sources     = [
#MISE   ".mise/config.toml",
#MISE   "Cargo.toml",
#MISE   "corpus/Cargo.toml",
#MISE   "crate/Cargo.toml",
#MISE   "crate/pyproject.toml",
#MISE   "site/package.json",
#MISE   "wasm/Cargo.toml"
#MISE ]

(cd site && bun install --ignore-scripts)
cargo update --workspace
mise lock
uv lock --project crate
git diff --stat .mise/mise.lock Cargo.lock crate/uv.lock site/bun.lock

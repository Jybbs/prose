#!/usr/bin/env -S bash -euo pipefail
#MISE alias       = "relock"
#MISE description = "Re-resolve every lockfile against its manifest"
#MISE outputs     = [
#MISE   ".mise/locks/**/*",
#MISE   ".mise/mise.lock",
#MISE   "Cargo.lock",
#MISE   "crate/uv.lock",
#MISE   "site/bun.lock"
#MISE ]
#MISE sources     = ["@group:manifests"]

(cd site && bun install --ignore-scripts)
cargo update --workspace
mise lock
uv lock --project crate
git status --short .mise/locks .mise/mise.lock Cargo.lock crate/uv.lock site/bun.lock

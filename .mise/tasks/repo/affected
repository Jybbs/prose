#!/usr/bin/env -S bash -euo pipefail
#MISE description = "Run the `tests/scripts` modules the changes since `origin/main` reach"

source "$MISE_PROJECT_ROOT/.mise/lib/changes.bash"

naming() {
  [[ -n $changed ]] || return 0
  git grep --files-with-matches --fixed-strings --untracked -f - \
    -- .mise/tasks tests/scripts <<<"$changed" || (($? == 1))
}

reached() {
  local path
  while IFS= read -r path; do
    case $path in
      .mise/config.toml | .mise/lib/* | crate/pyproject.toml | crate/uv.lock \
        | tests/scripts/conftest.py)
        echo tests/scripts
        ;;
      .mise/tasks/*)
        path=tests/scripts/${path#.mise/tasks/}
        echo "${path%.py}.py"
        ;;
      tests/scripts/*/conftest.py)
        echo "${path%/conftest.py}"
        ;;
      tests/scripts/*)
        echo "$path"
        ;;
    esac
  done
}

changed=$(changed_paths)
modules=()
readers=$(naming)
while IFS= read -r module; do
  if [[ -e $module ]]; then
    modules+=("$module")
  fi
done < <(reached <<<"$changed"$'\n'"$readers" | sort -u)

if ((${#modules[@]} == 0)); then
  echo "No task script or task test changed since origin/main"
else
  uv run \
    --locked \
    --only-group test \
    --project crate \
    pytest --numprocesses=auto "$@" "${modules[@]}"
fi

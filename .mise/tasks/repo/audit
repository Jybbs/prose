#!/usr/bin/env -S uv run --script
#MISE alias="audit"
#MISE description="Audit version-pin parity, action-manifest hygiene, and cache-trigger coverage"
# /// script
# requires-python = ">=3.11"
# ///
"""
Audit CI invariants no other gate covers, exiting nonzero if any of them fails.

    parity     Every cross-config pin and shared declaration agrees across
               its homes.
    manifests  No composite action manifest carries a YAML anchor, which
               the runner rejects before any step runs.
    triggers   The `module.yml` push trigger covers every wasm source path
               the module cache key hashes.

Findings surface as `::error::` annotations naming the divergence or file.
"""

from json    import loads as json_loads
from pathlib import Path
from re      import MULTILINE, findall, finditer, search
from tomllib import loads
from typing  import NoReturn


def action_pin(action: str, key: str) -> str:
    """
    Return the `key` input pinned in the `action` composite action.
    """
    return matched(
        f"no {key} pin in {action}/action.yml",
        manifest(action),
        rf"{key}\s*:\s*v?(\S+)"
    )


def action_pins() -> list[tuple[str, str, str]]:
    """
    Return one parity pair per repeat of a third-party action pin, comparing
    every later home's commit against the first home's.
    """
    homes: dict[str, list[tuple[str, str]]] = {}
    for path in sorted(Path(".github").rglob("*.yml")):
        text = path.read_text(encoding="utf-8")
        for match in finditer(r"uses\s*:\s*(?!\./)([\w.-]+/[\w./-]+)@(\S+)", text):
            homes.setdefault(match[1], []).append((str(path), match[2]))

    return [
        (f"{action} in {first} ↔ {home}", pin, repeat)
        for action, [(first, pin), *rest] in sorted(homes.items())
        for home, repeat in rest
    ]


def annotate(message: str, **location) -> None:
    """
    Emit a GitHub Actions error annotation, locating it to a file and line
    when `location` is given.
    """
    props = ",".join(f"{key}={value}" for key, value in location.items())
    print(f"::error {props}::{message}" if props else f"::error::{message}")


def badge(svg: str) -> str:
    """
    Return the `<major>.<minor>` token from the README badge line whose link
    target carries `svg`.
    """
    return matched(
        f"no README.md badge line carries {svg!r}",
        "README.md",
        rf"{svg}.*?(\d+\.\d+)\+"
    )


def build_requirement(name: str) -> str:
    """
    Return the exact version `crate/pyproject.toml` pins for the `name`
    build requirement.
    """
    for requirement in toml("crate/pyproject.toml")["build-system"]["requires"]:
        if requirement.startswith(name):
            return extract(
                f"{name} build requirement is not an exact pin",
                r"==\s*(\S+)",
                requirement
            )
    fail(f"no build-system requirement named {name!r}")


def cargo_lock_version(name: str) -> str:
    """
    Return the version `Cargo.lock` resolves for the `name` package.
    """
    for package in toml("Cargo.lock")["package"]:
        if package["name"] == name:
            return package["version"]
    fail(f"no Cargo.lock package named {name!r}")


def extract(message: str, pattern: str, text: str) -> str:
    """
    Return the first capture of `pattern` in `text`.
    """
    if match := search(pattern, text):
        return match.group(1)
    fail(message)


def fail(message: str) -> NoReturn:
    """
    Emit an error annotation for `message` and exit nonzero.
    """
    annotate(message)
    raise SystemExit(1)


def hashed_paths(action: str) -> list[str]:
    """
    Return the file paths listed in the `action` manifest's `hashFiles` call.
    """
    return findall(
        r"'([^']+)'",
        matched(
            f"no hashFiles call in {action}/action.yml",
            manifest(action),
            r"hashFiles\(([^)]*)\)"
        )
    )


def major_minor(value: str) -> str:
    """
    Return `<major>.<minor>` from any string carrying a SemVer head.
    """
    return extract(f"cannot parse major.minor from {value!r}", r"(\d+\.\d+)", value)


def manifest(action: str) -> str:
    """
    Return the path of the `action` composite action's manifest.
    """
    return f".github/actions/{action}/action.yml"


def manifests() -> int:
    """
    Report every YAML anchor in a composite action manifest, which the
    runner's manifest parser rejects before any step runs.
    """
    failed = 0
    for path in sorted(Path(".github/actions").glob("*/action.yml")):
        text = path.read_text(encoding="utf-8")
        for match in finditer(r"^\s*[\w-]+\s*:\s*&([\w-]+)", text, MULTILINE):
            annotate(
                f"YAML anchors are rejected in an action manifest, so remove {match.group(1)!r}",
                file = path,
                line = text[: match.start()].count("\n") + 1
            )
            failed = 1
    return failed


def matched(message: str, path: str, pattern: str) -> str:
    """
    Return the first capture of `pattern` in the file at `path`.
    """
    return extract(message, pattern, Path(path).read_text(encoding="utf-8"))


def member_pins(cargo: dict) -> list[tuple[str, list[str], list[str]]]:
    """
    Return one parity pair per list that restates the workspace members,
    comparing the manifests that list names against the ones the members own.
    """
    owned = sorted(f"{name}/Cargo.toml" for name in cargo["workspace"]["members"])
    return [
        (f"Cargo.toml members ↔ {home}", owned, named)
        for home, named in [
            (".github/workflows/warm.yml path filter", watched_manifests("warm")),
            (".mise/tasks/lock/check sources", sourced_manifests("lock/check")),
            (".mise/tasks/lock/sync sources", sourced_manifests("lock/sync"))
        ]
    ]


def override_pins(package: dict) -> list[tuple[str, str, str]]:
    """
    Return one parity pair per `overrides` entry the manifest also pins as a
    `devDependencies` entry, leaving an override of an undeclared transitive
    alone.
    """
    return [
        (
            f"site/package.json {name} override ↔ its devDependency pin",
            version,
            package["devDependencies"][name]
        )
        for name, version in package.get("overrides", {}).items()
        if name in package["devDependencies"]
    ]


def parity() -> int:
    """
    Report every cross-config pin or shared declaration that has drifted
    from its pair.
    """
    cargo   = toml("Cargo.toml")
    mise    = toml(".mise/config.toml")
    package = json_loads(Path("site/package.json").read_text(encoding="utf-8"))
    project = toml("crate/pyproject.toml")
    rust    = cargo["workspace"]["package"]["rust-version"]

    if isinstance(mise_rust := mise["tools"]["rust"], dict):
        mise_rust = mise_rust["version"]

    pairs = [
        (
            "README.md Rust badge ↔ Cargo.toml rust-version",
            badge("rust.svg"),
            major_minor(rust)
        ),
        (
            "Cargo.toml rust-version ↔ .mise/config.toml rust pin",
            major_minor(rust),
            major_minor(mise_rust)
        ),
        (
            "README.md Python badge ↔ crate/pyproject.toml requires-python",
            badge("python.svg"),
            major_minor(project["project"]["requires-python"])
        ),
        (
            ".mise/config.toml maturin pin ↔ build-wheel action maturin-version",
            mise["tools"]["maturin"],
            action_pin("build-wheel", "maturin-version")
        ),
        (
            ".mise/config.toml maturin pin ↔ crate/pyproject.toml build requirement",
            mise["tools"]["maturin"],
            build_requirement("maturin")
        ),
        (
            ".mise/config.toml wasm-bindgen pin ↔ Cargo.lock wasm-bindgen",
            mise["tools"]["github:rustwasm/wasm-bindgen"],
            cargo_lock_version("wasm-bindgen")
        ),
        (
            ".mise/tasks/site/test sources ↔ .mise/tasks/site/press sources",
            task_sources("site/test"),
            task_sources("site/press")
        ),
        (
            ".mise/tasks/wasm/pack sources ↔ restore-wasm hashFiles paths",
            task_sources("wasm/pack"),
            hashed_paths("restore-wasm")
        ),
        *action_pins(),
        *member_pins(cargo),
        *override_pins(package),
        *patch_pins(package)
    ]

    failed = 0
    for label, left, right in pairs:
        if left != right:
            annotate(f"parity mismatch in {label}: {left!r} vs {right!r}")
            failed = 1
    return failed


def patch_pins(package: dict) -> list[tuple[str, str, str]]:
    """
    Return one parity pair per `patchedDependencies` key, matching the version
    the key targets against the version the manifest pins for that package.
    """
    pairs = []
    for key in package.get("patchedDependencies", {}):
        name, _, version = key.rpartition("@")
        if (pinned := package["devDependencies"].get(name)) is None:
            fail(f"no site/package.json devDependency named {name!r}")
        pairs.append((
            f"site/package.json {name} patch key ↔ its devDependency pin",
            version,
            pinned
        ))
    return pairs


def sourced_manifests(task: str) -> list[str]:
    """
    Return every member manifest the `task` frontmatter's sources list names.
    """
    return [path for path in task_sources(task) if path.endswith("/Cargo.toml")]


def task_sources(task: str) -> list[str]:
    """
    Return the `sources` array the `task` file's `#MISE` frontmatter declares.
    """
    lines  = Path(f".mise/tasks/{task}").read_text(encoding="utf-8").splitlines()
    marked = (line.removeprefix("#MISE") for line in lines if line.startswith("#MISE"))
    table  = loads("\n".join(marked))
    if "sources" in table:
        return table["sources"]
    fail(f"no sources declaration in .mise/tasks/{task}")


def toml(path: str) -> dict:
    """
    Return the parsed TOML mapping at `path`.
    """
    return loads(Path(path).read_text(encoding="utf-8"))


def triggers() -> int:
    """
    Report every wasm source path the `module.yml` push trigger omits, which
    leaves the cached module stale after a change to that path.
    """
    if missing := set(hashed_paths("restore-wasm")) - set(workflow_paths("module")):
        annotate(f"module.yml push paths omit the wasm sources {sorted(missing)}")
        return 1
    return 0


def watched_manifests(name: str) -> list[str]:
    """
    Return every member manifest the `name` workflow's path filter watches.
    """
    text = Path(workflow(name)).read_text(encoding="utf-8")
    return sorted(
        match.group(1)
        for match in finditer(r"^\s*-\s+(\S+/Cargo\.toml)\s*$", text, MULTILINE)
    )


def workflow(name: str) -> str:
    """
    Return the path of the `name` workflow file.
    """
    return f".github/workflows/{name}.yml"


def workflow_paths(name: str) -> list[str]:
    """
    Return the paths the `name` workflow's push trigger filters on.
    """
    return findall(
        r"^\s+- (\S+)$",
        matched(
            f"no paths filter in {name}.yml",
            workflow(name),
            r"paths:\n((?:\s+- \S+\n)+)"
        ),
        MULTILINE
    )


if __name__ == "__main__":

    raise SystemExit(parity() | manifests() | triggers())

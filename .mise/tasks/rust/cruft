#!/usr/bin/env -S bash -euo pipefail
#MISE description = "Run the Rust suites, rejecting any orphaned `insta` snapshot"
#MISE sources     = [
#MISE   ".mise/config.toml",
#MISE   "Cargo.lock",
#MISE   "Cargo.toml",
#MISE   "crate/**/*",
#MISE   "site/**/*.md",

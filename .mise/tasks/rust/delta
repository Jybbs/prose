#!/usr/bin/env -S bash -euo pipefail
#MISE alias       = "delta"
#MISE description = "Compare this tree's formatting of a corpus against a baseline worktree's, or against a baked stage, at every line length"

source "$MISE_PROJECT_ROOT/.mise/lib/corpus.bash"
source "$MISE_PROJECT_ROOT/.mise/lib/delta.bash"

head_bin=$(built_binary)

if [[ -n "${PROSE_DELTA_STAGE:-}" ]]; then
  stage="$PROSE_DELTA_STAGE"
else
  base_tree=$(baseline_root "${1:-}")
  [[ "$base_tree" != "$(git rev-parse --show-toplevel)" ]] \
    || { echo "baseline $base_tree is this tree" >&2; exit 1; }
  base_bin=$(baseline_binary "$base_tree")
  corpus=$(corpus_root "${2:-}")
  stage=$(scratch_dir delta)
  stage_corpus "$corpus"
  baseline_label "$base_tree" > "$stage/.git/baseline"
fi

printf 'baseline %s\nhead     %s\ncorpus   %d files\nstage    %s\n\n' \
  "$(< "$stage/.git/baseline")" \
  "$(git describe --always --dirty)" \
  "$(staged ls-files | wc -l)" \
  "$stage"

if [[ -n "${base_bin:-}" ]]; then
  format_widths base "$base_bin"
fi
format_widths head "$head_bin"

printf '\n'
"$MISE_PROJECT_ROOT/.mise/lib/delta.py" \
  ${PROSE_DELTA_MARKDOWN:+--markdown} \
  "$stage" \
  $(delta_widths)

printf '\neach width survives as a tag pair in the stage, read one with\n'
printf '  git -C %s diff base-<width> head-<width> [-- <path>]\n' "$stage"

#!/usr/bin/env -S bash -euo pipefail
#MISE alias="delta"
#MISE description="Compare this tree's formatting of a corpus against a baseline ref's, at every line length"

base="${1:-main}"
corpus="${2:-$(python -c 'import sysconfig; print(sysconfig.get_paths()["stdlib"])')}"
widths="${PROSE_DELTA_WIDTHS:-40 50 60 79 88 100}"

rule_deltas() {
  python - "$1" "$2" <<'PY'
import json, sys

def fired(path):
    with open(path, encoding="utf-8") as handle:
        return json.load(handle)["rules_fired"]

base, head = (fired(path) for path in sys.argv[1:3])
rows = [
    (slug, base.get(slug, 0), head.get(slug, 0))
    for slug in sorted(set(base) | set(head))
    if base.get(slug, 0) != head.get(slug, 0)
]
if not rows:
    print("  every rule fired the same number of times")
for slug, before, after in rows:
    print(f"  {slug:34} {before:7} -> {after:<7} {after - before:+}")
PY
}

cargo build --release --bin prose --locked
head_bin="$MISE_PROJECT_ROOT/target/release/prose"

base_sha=$(git rev-parse "$base")
base_bin="${TMPDIR:-/tmp}/prose-baseline/$base_sha/prose"
if [[ ! -x "$base_bin" ]]; then
  source_tree=$(mktemp -d)
  git worktree add --detach "$source_tree" "$base_sha" >/dev/null
  (cd "$source_tree" && cargo build --release --bin prose --locked)
  mkdir -p "$(dirname "$base_bin")"
  cp "$source_tree/target/release/prose" "$base_bin"
  git worktree remove --force "$source_tree"
fi

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
printf 'baseline %s (%s)\nhead     %s\ncorpus   %s\n\n' "$base" "${base_sha:0:8}" "$(git rev-parse --short HEAD)" "$corpus"

for width in $widths; do
  for side in base head; do
    tree="$work/$width/$side"
    mkdir -p "$tree"
    (cd "$corpus" && find . -name '*.py' -print0 | tar -cf - --null -T -) | tar -xf - -C "$tree"
    printf 'code-line-length = %s\n' "$width" > "$tree/prose.toml"
  done
  (cd "$work/$width/base" && "$base_bin" format --no-cache --output-format json . 2>/dev/null | grep '"kind":"summary"' > "$work/$width.base.json") || true
  (cd "$work/$width/head" && "$head_bin" format --no-cache --output-format json . 2>/dev/null | grep '"kind":"summary"' > "$work/$width.head.json") || true
  rm -f "$work/$width"/*/prose.toml
  changed=$(git diff --no-index --name-only "$work/$width/base" "$work/$width/head" 2>/dev/null | wc -l | tr -d ' ') || true
  printf 'width %s: %s of %s files differ\n' "$width" "$changed" "$(find "$work/$width/head" -name '*.py' | wc -l | tr -d ' ')"
  rule_deltas "$work/$width.base.json" "$work/$width.head.json"
  git diff --no-index --numstat "$work/$width/base" "$work/$width/head" 2>/dev/null | awk '{a+=$1; d+=$2} END {if (NR) printf "  %d rows added, %d removed across %d files\n", a, d, NR}' || true
  printf '\n'
done

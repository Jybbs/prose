#!/usr/bin/env -S bash -euo pipefail
#MISE alias       = "mutations"
#MISE description = "Check every mutation of a corpus for output a second trip through the rules would change, generating the set under a budget where the named directory is absent"

source "$MISE_PROJECT_ROOT/.mise/lib/corpus.bash"

mutation_pass() {
  local variant="$1" log name
  name=$(basename "$variant")
  log="$mutations/$name.log"
  printf '\n%s with `target-version` %s: ' "$name" "$target"
  if PROSE_SETTLE_AXES=code PROSE_SETTLE_WIDTHS=88 \
    settle_corpus "$variant" --test corpus every_width > "$log" 2>&1; then
    echo 'every variant settles in one trip'
  else
    grep -q 'distinct defects' "$log" || { cat "$log" >&2; exit 1; }
    sed -n '/distinct defects/,/^note: /{/^note: /d;p;}' "$log"
  fi
}

corpus=$(corpus_root "${1:-}")
budget="${2:-60}"
target=$(corpus_target)

mutations="${PROSE_SETTLE_MUTATIONS:-}"
if [[ -z "$mutations" || ! -f "$mutations/.generated" ]]; then
  mutations="${mutations:-$(scratch_dir mutations)}"
  mutate_corpus "$corpus" "$mutations" "$budget"
fi

while IFS= read -r variant; do
  mutation_pass "$variant"
done < <(find "$mutations" -mindepth 1 -maxdepth 1 -type d | sort)

printf '\neach mutation survives as written under %s\n' "$mutations"

#!/usr/bin/env -S bash -euo pipefail
#MISE description="Report every corpus file the formatter rewrites on a second pass"

corpus="${1:-$(python -c 'import sysconfig; print(sysconfig.get_paths()["stdlib"])')}"

cargo build --release --bin prose --locked
prose="$MISE_PROJECT_ROOT/target/release/prose"
once=$(mktemp)
twice=$(mktemp)
trap 'rm -f "$once" "$twice"' EXIT

formatted=0
moved=0
while IFS= read -r -d '' file; do
  "$prose" format --no-cache --stdin --stdin-filename "$file" < "$file" > "$once" 2>/dev/null || true
  [[ -s "$once" ]] || continue
  "$prose" format --no-cache --stdin --stdin-filename "$file" < "$once" > "$twice" 2>/dev/null || true
  [[ -s "$twice" ]] || continue
  formatted=$((formatted + 1))
  if ! cmp -s "$once" "$twice"; then
    moved=$((moved + 1))
    printf '%s\n' "${file#"$corpus"/}"
  fi
done < <(find "$corpus" -name '*.py' -not -path '*/test/*' -not -path '*/tests/*' -not -path '*/site-packages/*' -print0)

printf '\n%d of %d files rewrite on a second pass\n' "$moved" "$formatted"

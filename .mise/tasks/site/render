#!/usr/bin/env -S bash -euo pipefail
#MISE alias       = "render"
#MISE depends     = ["site:press"]
#MISE description = "Read the values the browser computes on the pressed docs site with `vitest`"
#MISE dir         = "site"

mirrors=/etc/apt/apt-mirrors.txt

if [[ -f $mirrors ]]; then
  sudo sed -i '/\.ec2\.archive\.ubuntu\.com/s/priority:1$/priority:4/' "$mirrors"
fi

playwright install --only-shell --with-deps chromium webkit
vitest run --project render "$@"

#!/usr/bin/env -S bash -euo pipefail
#MISE description="Build the wasm module, emit its JS bindings, and run the browser smoke test against them"
#MISE depends=["bake"]
#MISE tools={"github:rustwasm/wasm-bindgen" = "0.2.120"}

mise run build wasm
wasm-bindgen --target nodejs --out-dir site/.vitepress/tests/wasm/pkg "$WASM_ARTIFACT"
(cd site && bunx vitest run --project wasm)

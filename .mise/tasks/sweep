#!/usr/bin/env -S bash -euo pipefail
#MISE description="Check the built site's off-site URLs with `lychee`"
#MISE depends=["press"]
#MISE tools={"aqua:lycheeverse/lychee" = "0.24.2"}
# lychee hardcodes its response cache as `.lycheecache` under the working
# directory, so the invocation runs inside `.cache/` to keep the file in the
# shared cache directory. Running there also keeps `site/lychee.toml`, the
# internal gate's exclude-everything config, out of lychee's config discovery.

constant() { (cd "$MISE_PROJECT_ROOT/site" && bun --print "require('./.vitepress/lib/shared/constants.ts').$1"); }
SITE_HOST=$(constant SITE_HOSTNAME) && SITE_HOST=${SITE_HOST#https://}
REPO_URL=$(constant REPO_URL)

cd "$MISE_PROJECT_ROOT/.cache"
lychee --no-progress \
  --scheme http --scheme https \
  --max-retries 3 --retry-wait-time 2 --timeout 30 \
  --cache --max-cache-age 1d --cache-exclude-status '429, 500..504' \
  --base-url "https://${SITE_HOST}" \
  --exclude "^https?://(www\.)?${SITE_HOST//./\\.}" \
  --exclude "^${REPO_URL//./\\.}/edit/" \
  --exclude '^https://www\.gnu\.org/' \
  "$MISE_PROJECT_ROOT/site/.vitepress/dist"

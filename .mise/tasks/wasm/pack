#!/usr/bin/env -S bash -euo pipefail
#MISE alias       = "pack"
#MISE description = "Build `prose_wasm` under `wasm-release`, then emit its web module into `site/public/wasm` and optimize it"
#MISE outputs     = ["site/public/wasm/*"]
#MISE sources     = ["@group:wasm"]

source "$MISE_PROJECT_ROOT/.mise/lib/wasm.bash"

out=site/public/wasm
target=$(cargo metadata --format-version 1 --no-deps | jq -r .target_directory)
trap 'rm -rf "$out"' ERR

wasm_cargo build

wasm-bindgen \
  --experimental-reset-state-function \
  --out-dir "$out" \
  --target web \
  "$target/wasm32-unknown-unknown/wasm-release/prose_wasm.wasm"
wasm-opt -O --output "$out/prose_wasm_bg.wasm" "$out/prose_wasm_bg.wasm"

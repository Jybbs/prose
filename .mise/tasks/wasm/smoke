#!/usr/bin/env -S bash -euo pipefail
#MISE alias       = "smoke"
#MISE depends     = ["site:bake", "wasm:pack"]
#MISE description = "Copy the packed web module out of `public/` and run the browser smoke test against it"

rm -rf site/.vitepress/tests/wasm/pkg
cp -R site/public/wasm site/.vitepress/tests/wasm/pkg
cd site
bunx playwright install --only-shell chromium
bunx vitest run --project wasm

---
source: crate/src/config/schema_tests.rs
expression: "serde_json::to_string_pretty(&schema).expect(\"renders\")"
---
{
  "$defs": {
    "AlignmentConfig": {
      "description": "Alignment-rule config shared by every rule that aligns a token\nacross consecutive lines.",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "max-shift": {
          "$ref": "#/$defs/MaxShift",
          "default": 16,
          "description": "The width-spread budget a contiguous run may shift to reach the\nshared column. A positive `N` caps the spread, `0` forbids any\nshift so every row sits flush, and `false` lifts the cap so a\ncontiguous run folds into one column. To hold one row out of an\notherwise-aligned group, mark it with `# prose: skip`."
        }
      },
      "type": "object"
    },
    "AlphabetizeConfig": {
      "description": "Configuration for the `alphabetize` rule, each facet gating one\nsort pass and defaulting `true`.",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "group-methods": {
          "default": true,
          "description": "Groups methods into dunders, properties, privates, and publics\nbefore sorting within each group. `false` sorts methods by plain\nname alone.",
          "type": "boolean"
        },
        "sort-definitions": {
          "default": true,
          "description": "Reorders class and function definitions alphabetically, holding\neach behind any sibling it names at evaluation time. `false`\nfreezes definitions in source order while other surfaces still\nsort.",
          "type": "boolean"
        },
        "sort-docstring-entries": {
          "default": true,
          "description": "Reorders `name: description` entries within Title-case-headed\ndocstring sections, parameter entries mirroring the signature as\nthe rule leaves it and stragglers alphabetizing below. `false`\nkeeps narrative-curated entry order while still sorting every\nother surface.",
          "type": "boolean"
        },
        "sort-dunder-lists": {
          "default": true,
          "description": "Reorders the string items inside `__all__` and `__slots__`.\n`false` keeps a hand-curated public-API order.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "BandConstantsConfig": {
      "description": "Configuration for the `band_constants` rule.",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "group-constants": {
          "default": true,
          "description": "Clusters each band by subcategory, the type aliases first, then\nthe `SCREAMING_CASE` constants, then the remaining module state,\nbefore sorting by name within each. `false` sorts by tier and\nname alone.",
          "type": "boolean"
        },
        "max-tiers": {
          "$ref": "#/$defs/InlineBudget",
          "default": 2,
          "description": "Caps how many evaluation tiers open their own blank-separated\nsub-band, merging every deeper tier into the last. `1` holds the\nband tight and `false` opens one sub-band per tier."
        }
      },
      "type": "object"
    },
    "BareImportsConfig": {
      "description": "Configuration for the `bare_imports` rule.",
      "properties": {
        "allow": {
          "default": [],
          "description": "Modules whose bare-import form is preserved whatever their\nattribute count.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "exempt-aliased": {
          "default": true,
          "description": "Exempts every aliased bare import (`import x as y`) from the rule.",
          "type": "boolean"
        },
        "max-attributes": {
          "default": 4,
          "description": "The distinct-attribute count at or below which an unaliased bare\nimport is flagged.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "CacheConfig": {
      "description": "Cache settings parsed from `[tool.prose.cache]`.",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Toggles the cache globally.",
          "type": "boolean"
        },
        "max-size-mib": {
          "default": 100,
          "description": "The LRU eviction cap on the cache directory.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "CallLayoutConfig": {
      "description": "Configuration for the `call_layout` rule.",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "max-args": {
          "$ref": "#/$defs/InlineBudget",
          "default": 3,
          "description": "Explodes a call to one keyword argument per line once its argument\ncount exceeds the cap. `false` disables the count trigger and\nleaves every call inline."
        }
      },
      "type": "object"
    },
    "CollectionLayoutConfig": {
      "description": "Configuration for the `collection_layout` rule, each shape facet\ngating one move and defaulting `true`.",
      "properties": {
        "collapse": {
          "default": true,
          "description": "Joins a fitting multi-line literal, subscript, comprehension, or\ndict key back to one line. `false` freezes those shapes where they\nsit.",
          "type": "boolean"
        },
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "explode": {
          "default": true,
          "description": "Expands an overflowing or over-count collection to one entry per\nline. `false` suppresses every expansion and leaves the count cap\ninert.",
          "type": "boolean"
        },
        "max-atomics": {
          "$ref": "#/$defs/InlineBudget",
          "default": 8,
          "description": "Keeps short collections on one line when each entry is an atomic\nliteral and the run fits the cap. `false` removes the cap and\npacks by width alone."
        },
        "max-dict-entries": {
          "$ref": "#/$defs/InlineBudget",
          "default": 3,
          "description": "Expands a dict once its entry count exceeds the cap, whatever its\nwidth. `false` disables the count trigger."
        },
        "wrap-dict-entries": {
          "default": true,
          "description": "Breaks an over-wide `key: value` at its `:` and hangs the value\nbeneath. `false` leaves the oversized entry on one line.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "DocstringStructuredPolicy": {
      "description": "Which budget structured docstring sections wrap to.\n\n`CodeLineLength` reuses `Config::code_line_length`.\n`DocstringLineLength` reuses `Config::docstring_line_length`.",
      "enum": [
        "code-line-length",
        "docstring-line-length"
      ],
      "type": "string"
    },
    "ImportsConfig": {
      "description": "Settings parsed from `[tool.prose.imports]`.",
      "properties": {
        "first-party": {
          "default": [],
          "description": "Root package names whose imports lift into the local-package\ngroup.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "InlineBudget": {
      "anyOf": [
        {
          "format": "uint",
          "minimum": 1,
          "type": "integer"
        },
        {
          "const": false
        }
      ]
    },
    "MaxShift": {
      "anyOf": [
        {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        {
          "const": false
        }
      ]
    },
    "MiscasedConstantsConfig": {
      "description": "Configuration for the `miscased_constants` rule.",
      "properties": {
        "allow-pattern": {
          "default": "",
          "description": "Constant names exempted from the lint, such as old-style bare\naliases.",
          "format": "regex",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "PythonVersion": {
      "anyOf": [
        {
          "pattern": "^\\d+\\.\\d+$",
          "type": "string"
        },
        {
          "const": "3.7",
          "description": "Python 3.7"
        },
        {
          "const": "3.8",
          "description": "Python 3.8"
        },
        {
          "const": "3.9",
          "description": "Python 3.9"
        },
        {
          "const": "3.10",
          "description": "Python 3.10"
        },
        {
          "const": "3.11",
          "description": "Python 3.11"
        },
        {
          "const": "3.12",
          "description": "Python 3.12"
        },
        {
          "const": "3.13",
          "description": "Python 3.13"
        },
        {
          "const": "3.14",
          "description": "Python 3.14"
        },
        {
          "const": "3.15",
          "description": "Python 3.15"
        }
      ]
    },
    "ReassignedConstantsConfig": {
      "description": "Configuration for the `reassigned_constants` rule.",
      "properties": {
        "allow": {
          "default": [],
          "description": "Module-level names exempted from the lint.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "enabled": {
          "default": true,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "RuleConfigs": {
      "description": "Per-rule configuration under `[tool.prose.rules]`.",
      "properties": {
        "align-colons": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/AlignmentConfig"
            }
          ],
          "default": {
            "enabled": true,
            "max-shift": 16
          }
        },
        "align-comparisons": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/AlignmentConfig"
            }
          ],
          "default": {
            "enabled": true,
            "max-shift": 16
          }
        },
        "align-equals": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/AlignmentConfig"
            }
          ],
          "default": {
            "enabled": true,
            "max-shift": 16
          }
        },
        "align-imports": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/AlignmentConfig"
            }
          ],
          "default": {
            "enabled": true,
            "max-shift": 16
          }
        },
        "align-match-case": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/AlignmentConfig"
            }
          ],
          "default": {
            "enabled": true,
            "max-shift": 16
          }
        },
        "alphabetize": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/AlphabetizeConfig"
            }
          ],
          "default": {
            "enabled": true,
            "group-methods": true,
            "sort-definitions": true,
            "sort-docstring-entries": true,
            "sort-dunder-lists": true
          }
        },
        "band-constants": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/BandConstantsConfig"
            }
          ],
          "default": {
            "enabled": true,
            "group-constants": true,
            "max-tiers": 2
          }
        },
        "bare-imports": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/BareImportsConfig"
            }
          ],
          "default": {
            "allow": [],
            "enabled": true,
            "exempt-aliased": true,
            "max-attributes": 4
          }
        },
        "blank-lines": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ToggleOnly"
            }
          ],
          "default": {
            "enabled": true
          }
        },
        "call-layout": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/CallLayoutConfig"
            }
          ],
          "default": {
            "enabled": true,
            "max-args": 3
          }
        },
        "collection-layout": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/CollectionLayoutConfig"
            }
          ],
          "default": {
            "collapse": true,
            "enabled": true,
            "explode": true,
            "max-atomics": 8,
            "max-dict-entries": 3,
            "wrap-dict-entries": true
          }
        },
        "docstring-expand": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ToggleOnly"
            }
          ],
          "default": {
            "enabled": true
          }
        },
        "docstring-frame": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ToggleOnly"
            }
          ],
          "default": {
            "enabled": true
          }
        },
        "docstring-wrap": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ToggleOnly"
            }
          ],
          "default": {
            "enabled": true
          }
        },
        "group-imports": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ToggleOnly"
            }
          ],
          "default": {
            "enabled": true
          }
        },
        "import-layout": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ToggleOnly"
            }
          ],
          "default": {
            "enabled": true
          }
        },
        "legacy-union-syntax": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ToggleOnly"
            }
          ],
          "default": {
            "enabled": true
          }
        },
        "line-overflow": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ToggleOnly"
            }
          ],
          "default": {
            "enabled": true
          }
        },
        "miscased-constants": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/MiscasedConstantsConfig"
            }
          ],
          "default": {
            "allow-pattern": "",
            "enabled": true
          }
        },
        "reassigned-constants": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ReassignedConstantsConfig"
            }
          ],
          "default": {
            "allow": [],
            "enabled": true
          }
        },
        "shed-parentheses": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ToggleOnly"
            }
          ],
          "default": {
            "enabled": true
          }
        },
        "signature-annotations": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ToggleOnly"
            }
          ],
          "default": {
            "enabled": true
          }
        },
        "signature-layout": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/SignatureLayoutConfig"
            }
          ],
          "default": {
            "enabled": true,
            "max-params": 4
          }
        },
        "single-use-variables": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/SingleUseVariablesConfig"
            }
          ],
          "default": {
            "allow-pattern": "^_",
            "enabled": true
          }
        },
        "step-narration": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ToggleOnly"
            }
          ],
          "default": {
            "enabled": true
          }
        },
        "strip-align-padding": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ToggleOnly"
            }
          ],
          "default": {
            "enabled": true
          }
        },
        "strip-none-return": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ToggleOnly"
            }
          ],
          "default": {
            "enabled": true
          }
        },
        "strip-trailing-commas": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ToggleOnly"
            }
          ],
          "default": {
            "enabled": true
          }
        },
        "unsorted-parameters": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ToggleOnly"
            }
          ],
          "default": {
            "enabled": true
          }
        },
        "unused-future-annotations": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ToggleOnly"
            }
          ],
          "default": {
            "enabled": true
          }
        }
      },
      "type": "object"
    },
    "SignatureLayoutConfig": {
      "description": "Configuration for the `signature_layout` rule.",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "max-params": {
          "$ref": "#/$defs/InlineBudget",
          "default": 4,
          "description": "Expands a signature to one parameter per line once its parameter\ncount exceeds the cap. `false` disables the count trigger and\nleaves only the `code-line-length` budget."
        }
      },
      "type": "object"
    },
    "SingleUseVariablesConfig": {
      "description": "Configuration for the `single_use_variables` rule.",
      "properties": {
        "allow-pattern": {
          "default": "^_",
          "description": "Binding names exempted from the lint.",
          "format": "regex",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "ToggleOnly": {
      "description": "Sub-table shape for rules whose only knob is `enabled`.",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Toggles the rule on or off.",
          "type": "boolean"
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The resolved `prose` configuration, read from a `prose.toml` or\n`.config/prose.toml` document root, or a `pyproject.toml`\n`[tool.prose]` table.\n\n`code_line_length` defaults to `Some(88)`. `docstring_line_length`\ndefaults to `Some(76)`. `import_line_length` defaults to `Some(120)`,\nfalling back to `code_line_length` when `false`.\n`docstring_structured_policy` defaults to `CodeLineLength`.\n`imports.first_party` defaults to empty. `target_version` defaults\nto `None`. Per-rule settings live under `rules`.",
  "properties": {
    "cache": {
      "$ref": "#/$defs/CacheConfig",
      "default": {
        "enabled": true,
        "max-size-mib": 100
      }
    },
    "code-line-length": {
      "default": 88,
      "description": "The line budget every length-aware rule honors.",
      "format": "uint",
      "minimum": 1,
      "type": [
        "integer",
        "null"
      ]
    },
    "docstring-line-length": {
      "default": 76,
      "description": "The description-prose budget for `docstring-wrap`.",
      "format": "uint",
      "minimum": 1,
      "type": [
        "integer",
        "null"
      ]
    },
    "docstring-structured-policy": {
      "$ref": "#/$defs/DocstringStructuredPolicy",
      "default": "code-line-length",
      "description": "The budget structured docstring sections wrap to."
    },
    "import-line-length": {
      "anyOf": [
        {
          "format": "uint",
          "minimum": 1,
          "type": "integer"
        },
        {
          "const": false
        }
      ],
      "default": 120,
      "description": "The import-wrap budget for `import-layout`, falling back to\n`code-line-length` when `false`."
    },
    "imports": {
      "$ref": "#/$defs/ImportsConfig",
      "default": {
        "first-party": []
      }
    },
    "rules": {
      "$ref": "#/$defs/RuleConfigs",
      "default": {
        "align-colons": {
          "enabled": true,
          "max-shift": 16
        },
        "align-comparisons": {
          "enabled": true,
          "max-shift": 16
        },
        "align-equals": {
          "enabled": true,
          "max-shift": 16
        },
        "align-imports": {
          "enabled": true,
          "max-shift": 16
        },
        "align-match-case": {
          "enabled": true,
          "max-shift": 16
        },
        "alphabetize": {
          "enabled": true,
          "group-methods": true,
          "sort-definitions": true,
          "sort-docstring-entries": true,
          "sort-dunder-lists": true
        },
        "band-constants": {
          "enabled": true,
          "group-constants": true,
          "max-tiers": 2
        },
        "bare-imports": {
          "allow": [],
          "enabled": true,
          "exempt-aliased": true,
          "max-attributes": 4
        },
        "blank-lines": {
          "enabled": true
        },
        "call-layout": {
          "enabled": true,
          "max-args": 3
        },
        "collection-layout": {
          "collapse": true,
          "enabled": true,
          "explode": true,
          "max-atomics": 8,
          "max-dict-entries": 3,
          "wrap-dict-entries": true
        },
        "docstring-expand": {
          "enabled": true
        },
        "docstring-frame": {
          "enabled": true
        },
        "docstring-wrap": {
          "enabled": true
        },
        "group-imports": {
          "enabled": true
        },
        "import-layout": {
          "enabled": true
        },
        "legacy-union-syntax": {
          "enabled": true
        },
        "line-overflow": {
          "enabled": true
        },
        "miscased-constants": {
          "allow-pattern": "",
          "enabled": true
        },
        "reassigned-constants": {
          "allow": [],
          "enabled": true
        },
        "shed-parentheses": {
          "enabled": true
        },
        "signature-annotations": {
          "enabled": true
        },
        "signature-layout": {
          "enabled": true,
          "max-params": 4
        },
        "single-use-variables": {
          "allow-pattern": "^_",
          "enabled": true
        },
        "step-narration": {
          "enabled": true
        },
        "strip-align-padding": {
          "enabled": true
        },
        "strip-none-return": {
          "enabled": true
        },
        "strip-trailing-commas": {
          "enabled": true
        },
        "unsorted-parameters": {
          "enabled": true
        },
        "unused-future-annotations": {
          "enabled": true
        }
      }
    },
    "target-version": {
      "anyOf": [
        {
          "$ref": "#/$defs/PythonVersion"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The Python runtime the project ships to, read by the\nversion-gated rules."
    }
  },
  "title": "Config",
  "type": "object"
}

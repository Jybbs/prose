---
source: crate/src/config/schema_tests.rs
expression: "serde_json::to_string_pretty(&schema).expect(\"renders\")"
---
{
  "$defs": {
    "AlignmentConfig": {
      "description": "Alignment-rule config shared by every rule that aligns a token\nacross consecutive lines.",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "max-shift": {
          "$ref": "#/$defs/MaxShift",
          "default": 16,
          "description": "The width-spread budget a contiguous run may shift to reach the\nshared column. A positive `N` caps the spread, `0` forbids any\nshift so every row sits flush, and `false` lifts the cap so a\ncontiguous run folds into one column. To hold one row out of an\notherwise-aligned group, mark it with `# prose: skip`."
        }
      },
      "type": "object"
    },
    "AlphabetizeSiblingsConfig": {
      "description": "Configuration for the `alphabetize-siblings` rule, each facet gating one\nsort pass and defaulting `true`.",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "group-methods": {
          "default": true,
          "description": "Groups methods into dunders, properties, privates, and publics\nbefore sorting within each group. `false` sorts methods by plain\nname alone.",
          "type": "boolean"
        },
        "sort-definitions": {
          "default": true,
          "description": "Reorders class and function definitions alphabetically, holding\neach behind any sibling it names at evaluation time. `false`\nfreezes definitions in source order while other surfaces still\nsort.",
          "type": "boolean"
        },
        "sort-dict-keys": {
          "default": true,
          "description": "Reorders the keyed entries of a dict literal, scalar-valued\nentries before collection-valued and alphabetical by key within\neach. `false` keeps the authored order, which iteration,\n`.items()`, and `**` expansion all observe.",
          "type": "boolean"
        },
        "sort-docstring-entries": {
          "default": true,
          "description": "Reorders `name: description` entries within Title-case-headed\ndocstring sections, parameter entries mirroring the signature as\nthe rule leaves it and stragglers alphabetizing below. `false`\nkeeps narrative-curated entry order while still sorting every\nother surface.",
          "type": "boolean"
        },
        "sort-dunder-lists": {
          "default": true,
          "description": "Reorders the string items inside `__all__` and `__slots__`.\n`false` keeps a hand-curated public-API order.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "BandConstantsConfig": {
      "description": "Configuration for the `band-constants` rule.",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "group-subcategories": {
          "default": true,
          "description": "Clusters each band by subcategory, the type aliases first, then\nthe `SCREAMING_CASE` constants, then the remaining module state,\nbefore sorting by name within each. `false` sorts by tier and\nname alone.",
          "type": "boolean"
        },
        "max-tiers": {
          "$ref": "#/$defs/InlineBudget",
          "default": 2,
          "description": "Caps how many evaluation tiers open their own blank-separated\nsub-band, merging every deeper tier into the last. `1` holds the\nband tight and `false` opens one sub-band per tier."
        }
      },
      "type": "object"
    },
    "BareImportsConfig": {
      "description": "Configuration for the `bare-imports` rule.",
      "properties": {
        "allow": {
          "default": [],
          "description": "Modules whose bare-import form is preserved whatever their\nattribute count.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "exempt-aliased": {
          "default": true,
          "description": "Exempts every aliased bare import (`import x as y`) from the rule.",
          "type": "boolean"
        },
        "max-attributes": {
          "default": 4,
          "description": "The distinct-attribute count at or below which an unaliased bare\nimport is flagged.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "CacheConfig": {
      "description": "Cache settings parsed from `[tool.prose.cache]`.",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Toggles the cache globally.",
          "type": "boolean"
        },
        "max-size-mib": {
          "default": 100,
          "description": "The LRU eviction cap on the cache directory.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "DocstringStructuredPolicy": {
      "description": "Which budget structured docstring sections wrap to.\n\n`CodeLineLength` reuses `Config::code_line_length`.\n`DocstringLineLength` reuses `Config::docstring_line_length`.",
      "enum": [
        "code-line-length",
        "docstring-line-length"
      ],
      "type": "string"
    },
    "ImportsConfig": {
      "description": "Settings parsed from `[tool.prose.imports]`.",
      "properties": {
        "first-party": {
          "default": [],
          "description": "Root package names whose imports lift into the local-package\ngroup.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "InlineBudget": {
      "anyOf": [
        {
          "format": "uint",
          "minimum": 1,
          "type": "integer"
        },
        {
          "const": false
        }
      ]
    },
    "LineOverflowConfig": {
      "description": "Configuration for the `line-overflow` rule.",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "suggest-string-splits": {
          "default": true,
          "description": "Offers the parenthesized adjacent-literal form on an over-budget\nline whose overflow sits inside one string literal holding\ninterior whitespace, as a display-only suggestion `prose format`\nnever writes. `false` leaves the bare overflow report.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "MaxShift": {
      "anyOf": [
        {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        {
          "const": false
        }
      ]
    },
    "MiscasedConstantsConfig": {
      "description": "Configuration for the `miscased-constants` rule.",
      "properties": {
        "allow-pattern": {
          "default": "",
          "description": "Constant names exempted from the lint, such as old-style bare\naliases.",
          "format": "regex",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "ModernizeAnnotationsConfig": {
      "description": "Configuration for the `modernize-annotations` rule, each facet\ngating one rewrite and defaulting `true`.",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "rewrite-generics": {
          "default": true,
          "description": "Converts a `typing` generic to the builtin PEP 585 gave it, so\n`List[int]` reads as `list[int]`. Runs on `target-version` 3.9\nand higher, and `false` leaves every `typing` generic in place.",
          "type": "boolean"
        },
        "rewrite-unions": {
          "default": true,
          "description": "Rewrites `Optional[X]` and `Union[X, Y]` to the PEP 604 `X | None`\nand `X | Y` forms. Runs on `target-version` 3.10 and higher, and\n`false` leaves every legacy union in place.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "NormalizeComparisonsConfig": {
      "description": "Configuration for the `normalize-comparisons` rule, each facet\ngating one rewrite and defaulting `true`.",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "rewrite-identity": {
          "default": true,
          "description": "Rewrites a `==` or `!=` test against `None` to `is` or `is not`,\nand flags a test against `True` or `False` without rewriting it.\n`false` leaves every singleton comparison as written.",
          "type": "boolean"
        },
        "rewrite-negation": {
          "default": true,
          "description": "Folds a leading `not` into the `in` or `is` it negates, so\n`not a in b` reads `a not in b`. `false` keeps the outer `not`.",
          "type": "boolean"
        },
        "rewrite-operand-order": {
          "default": true,
          "description": "Flips a comparison whose constant side leads, so `42 == n` reads\n`n == 42`. `false` keeps the authored operand order.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "NormalizeLiteralsConfig": {
      "description": "Configuration for the `normalize-literals` rule, each facet gating\none spelling axis and defaulting `true`.",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "unify-numerics": {
          "default": true,
          "description": "Uppercases hex digits and lowercases the `0x`, `0o`, and `0b`\nradix markers, the `e` exponent, and the `j` suffix. `false`\nkeeps every numeric literal spelled as written.",
          "type": "boolean"
        },
        "unify-prefixes": {
          "default": true,
          "description": "Lowercases a string prefix and drops the no-op `u`. `false`\nkeeps the prefix cased and ordered as written.",
          "type": "boolean"
        },
        "unify-quotes": {
          "default": true,
          "description": "Settles a non-docstring string on `\"`, falling to `'` only where\nthat drops an escape, and sheds a backslash the surviving quote\ndoes not need. `false` keeps the literal spelled as written.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "PreferFstringConfig": {
      "description": "Configuration for the `prefer-fstring` rule, each facet gating one\nrewrite and defaulting `true`.",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "rewrite-percent": {
          "default": true,
          "description": "Converts printf-style `%` interpolation to an f-string, so\n`\"%s=%s\" % (k, v)` reads as `f\"{k}={v}\"`. `false` leaves every\n`%` template in place.",
          "type": "boolean"
        },
        "rewrite-str-format": {
          "default": true,
          "description": "Converts a `str.format()` call to an f-string, so\n`\"{}={}\".format(k, v)` reads as `f\"{k}={v}\"`. `false` leaves\nevery `str.format()` call in place.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "PruneInertImportsConfig": {
      "description": "Configuration for the `prune-inert-imports` rule, each facet gating\none prune and defaulting `true`.",
      "properties": {
        "drop-duplicates": {
          "default": true,
          "description": "Drops an import rebinding a name an earlier import already bound\nto the same source. `false` keeps every repeat.",
          "type": "boolean"
        },
        "drop-unreferenced": {
          "default": true,
          "description": "Drops an import binding a name nothing references, where the\nbinding is not marked for re-export, read by a `del` or a quoted\nannotation, or bound in a package `__init__.py`, where it is\nreported instead. `false` leaves every unreferenced import in\nplace and reports none of them.",
          "type": "boolean"
        },
        "enabled": {
          "default": true,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "PythonVersion": {
      "anyOf": [
        {
          "pattern": "^\\d+\\.\\d+$",
          "type": "string"
        },
        {
          "const": "3.7",
          "description": "Python 3.7"
        },
        {
          "const": "3.8",
          "description": "Python 3.8"
        },
        {
          "const": "3.9",
          "description": "Python 3.9"
        },
        {
          "const": "3.10",
          "description": "Python 3.10"
        },
        {
          "const": "3.11",
          "description": "Python 3.11"
        },
        {
          "const": "3.12",
          "description": "Python 3.12"
        },
        {
          "const": "3.13",
          "description": "Python 3.13"
        },
        {
          "const": "3.14",
          "description": "Python 3.14"
        },
        {
          "const": "3.15",
          "description": "Python 3.15"
        }
      ]
    },
    "ReassignedConstantsConfig": {
      "description": "Configuration for the `reassigned-constants` rule.",
      "properties": {
        "allow": {
          "default": [],
          "description": "Module-level names exempted from the lint.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "enabled": {
          "default": true,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "ReflowCallsConfig": {
      "description": "Configuration for the `reflow-calls` rule.",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "max-args": {
          "$ref": "#/$defs/InlineBudget",
          "default": 3,
          "description": "Explodes a call to one keyword argument per line once its argument\ncount exceeds the cap. `false` disables the count trigger and\nleaves every call inline."
        }
      },
      "type": "object"
    },
    "ReflowCollectionsConfig": {
      "description": "Configuration for the `reflow-collections` rule, each facet gating\none shape decision and defaulting `true`.",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "explode": {
          "default": true,
          "description": "Expands an overflowing or over-count collection to one entry per\nline. `false` suppresses every expansion and leaves the count cap\ninert.",
          "type": "boolean"
        },
        "keep-multiline-literals": {
          "default": true,
          "description": "Holds a literal the author laid out as a flush bracketed column\nof two or more entries. `false` joins one whose single-line form\nfits the budget, and every other break rejoins either way.",
          "type": "boolean"
        },
        "max-atomics": {
          "$ref": "#/$defs/InlineBudget",
          "default": 8,
          "description": "Keeps short collections on one line when each entry is an atomic\nliteral and the run fits the cap. `false` removes the cap and\npacks by width alone."
        },
        "max-dict-entries": {
          "$ref": "#/$defs/InlineBudget",
          "default": 3,
          "description": "Expands a dict once its entry count exceeds the cap, whatever its\nwidth. `false` disables the count trigger."
        },
        "wrap-dict-entries": {
          "default": true,
          "description": "Breaks an over-wide `key: value` at its `:` and hangs the value\nbeneath. `false` leaves the oversized entry on one line.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "ReflowImportsConfig": {
      "description": "Configuration for the `reflow-imports` rule, each facet gating one\nstatement move and defaulting `true`.",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "merge-members": {
          "default": true,
          "description": "Folds repeated `from <module> import …` statements into one\nstatement carrying each member once, ordered as `alphabetize-siblings`\nwould leave it. `false` leaves each statement on its own line.",
          "type": "boolean"
        },
        "split-multi-module": {
          "default": true,
          "description": "Breaks a comma-joined `import a, b` into one `import` statement\nper module. `false` keeps the comma-joined form.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "ReflowSignaturesConfig": {
      "description": "Configuration for the `reflow-signatures` rule.",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "max-params": {
          "$ref": "#/$defs/InlineBudget",
          "default": 4,
          "description": "Expands a signature to one parameter per line once its parameter\ncount exceeds the cap. `false` disables the count trigger and\nleaves only the `code-line-length` budget."
        }
      },
      "type": "object"
    },
    "RuleConfigs": {
      "description": "Per-rule configuration under `[tool.prose.rules]`.",
      "properties": {
        "align-colons": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/AlignmentConfig"
            }
          ],
          "default": {
            "enabled": true,
            "max-shift": 16
          }
        },
        "align-comments": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/AlignmentConfig"
            }
          ],
          "default": {
            "enabled": true,
            "max-shift": 16
          }
        },
        "align-comparisons": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/AlignmentConfig"
            }
          ],
          "default": {
            "enabled": true,
            "max-shift": 16
          }
        },
        "align-equals": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/AlignmentConfig"
            }
          ],
          "default": {
            "enabled": true,
            "max-shift": 16
          }
        },
        "align-imports": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/AlignmentConfig"
            }
          ],
          "default": {
            "enabled": true,
            "max-shift": 16
          }
        },
        "align-match-case": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/AlignmentConfig"
            }
          ],
          "default": {
            "enabled": true,
            "max-shift": 16
          }
        },
        "alphabetize-siblings": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/AlphabetizeSiblingsConfig"
            }
          ],
          "default": {
            "enabled": true,
            "group-methods": true,
            "sort-definitions": true,
            "sort-dict-keys": true,
            "sort-docstring-entries": true,
            "sort-dunder-lists": true
          }
        },
        "band-constants": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/BandConstantsConfig"
            }
          ],
          "default": {
            "enabled": true,
            "group-subcategories": true,
            "max-tiers": 2
          }
        },
        "bare-imports": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/BareImportsConfig"
            }
          ],
          "default": {
            "allow": [],
            "enabled": true,
            "exempt-aliased": true,
            "max-attributes": 4
          }
        },
        "expand-docstrings": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ToggleOnly"
            }
          ],
          "default": {
            "enabled": true
          }
        },
        "frame-docstrings": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ToggleOnly"
            }
          ],
          "default": {
            "enabled": true
          }
        },
        "group-imports": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ToggleOnly"
            }
          ],
          "default": {
            "enabled": true
          }
        },
        "line-overflow": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/LineOverflowConfig"
            }
          ],
          "default": {
            "enabled": true,
            "suggest-string-splits": true
          }
        },
        "miscased-constants": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/MiscasedConstantsConfig"
            }
          ],
          "default": {
            "allow-pattern": "",
            "enabled": true
          }
        },
        "modernize-annotations": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ModernizeAnnotationsConfig"
            }
          ],
          "default": {
            "enabled": true,
            "rewrite-generics": true,
            "rewrite-unions": true
          }
        },
        "normalize-comment-spacing": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ToggleOnly"
            }
          ],
          "default": {
            "enabled": true
          }
        },
        "normalize-comparisons": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/NormalizeComparisonsConfig"
            }
          ],
          "default": {
            "enabled": true,
            "rewrite-identity": true,
            "rewrite-negation": true,
            "rewrite-operand-order": true
          }
        },
        "normalize-literals": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/NormalizeLiteralsConfig"
            }
          ],
          "default": {
            "enabled": true,
            "unify-numerics": true,
            "unify-prefixes": true,
            "unify-quotes": true
          }
        },
        "prefer-fstring": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/PreferFstringConfig"
            }
          ],
          "default": {
            "enabled": true,
            "rewrite-percent": true,
            "rewrite-str-format": true
          }
        },
        "prune-inert-imports": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/PruneInertImportsConfig"
            }
          ],
          "default": {
            "drop-duplicates": true,
            "drop-unreferenced": true,
            "enabled": true
          }
        },
        "reassigned-constants": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ReassignedConstantsConfig"
            }
          ],
          "default": {
            "allow": [],
            "enabled": true
          }
        },
        "reflow-calls": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ReflowCallsConfig"
            }
          ],
          "default": {
            "enabled": true,
            "max-args": 3
          }
        },
        "reflow-collections": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ReflowCollectionsConfig"
            }
          ],
          "default": {
            "enabled": true,
            "explode": true,
            "keep-multiline-literals": true,
            "max-atomics": 8,
            "max-dict-entries": 3,
            "wrap-dict-entries": true
          }
        },
        "reflow-imports": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ReflowImportsConfig"
            }
          ],
          "default": {
            "enabled": true,
            "merge-members": true,
            "split-multi-module": true
          }
        },
        "reflow-signatures": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ReflowSignaturesConfig"
            }
          ],
          "default": {
            "enabled": true,
            "max-params": 4
          }
        },
        "restated-types": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ToggleOnly"
            }
          ],
          "default": {
            "enabled": true
          }
        },
        "shed-backslash-continuations": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ToggleOnly"
            }
          ],
          "default": {
            "enabled": true
          }
        },
        "shed-parentheses": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ToggleOnly"
            }
          ],
          "default": {
            "enabled": true
          }
        },
        "shed-redundant-base": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ToggleOnly"
            }
          ],
          "default": {
            "enabled": true
          }
        },
        "shed-super-args": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ToggleOnly"
            }
          ],
          "default": {
            "enabled": true
          }
        },
        "signature-annotations": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ToggleOnly"
            }
          ],
          "default": {
            "enabled": true
          }
        },
        "simplify-comprehensions": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ToggleOnly"
            }
          ],
          "default": {
            "enabled": true
          }
        },
        "single-use-variables": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/SingleUseVariablesConfig"
            }
          ],
          "default": {
            "allow-pattern": "^_",
            "enabled": true
          }
        },
        "space-statements": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ToggleOnly"
            }
          ],
          "default": {
            "enabled": true
          }
        },
        "stack-adjacent-strings": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ToggleOnly"
            }
          ],
          "default": {
            "enabled": true
          }
        },
        "stack-method-chains": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/StackMethodChainsConfig"
            }
          ],
          "default": {
            "enabled": true,
            "max-links": 2,
            "max-shift": 16
          }
        },
        "step-narration": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ToggleOnly"
            }
          ],
          "default": {
            "enabled": true
          }
        },
        "strip-none-return": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ToggleOnly"
            }
          ],
          "default": {
            "enabled": true
          }
        },
        "strip-stranded-padding": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ToggleOnly"
            }
          ],
          "default": {
            "enabled": true
          }
        },
        "strip-trailing-commas": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ToggleOnly"
            }
          ],
          "default": {
            "enabled": true
          }
        },
        "unsorted-positionals": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ToggleOnly"
            }
          ],
          "default": {
            "enabled": true
          }
        },
        "wrap-docstrings": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/ToggleOnly"
            }
          ],
          "default": {
            "enabled": true
          }
        }
      },
      "type": "object"
    },
    "SingleUseVariablesConfig": {
      "description": "Configuration for the `single-use-variables` rule.",
      "properties": {
        "allow-pattern": {
          "default": "^_",
          "description": "Binding names exempted from the lint.",
          "format": "regex",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "StackMethodChainsConfig": {
      "description": "Configuration for the `stack-method-chains` rule.",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "max-links": {
          "$ref": "#/$defs/InlineBudget",
          "default": 2,
          "description": "Breaks a method chain to one link per line once its link count\nexceeds the cap. `false` disables the count trigger and leaves\nonly the `code-line-length` budget."
        },
        "max-shift": {
          "$ref": "#/$defs/MaxShift",
          "default": 16,
          "description": "The width a hung link's dot column may sit past the indent the\nbroken chain opens at. A wider receiver takes the full split\ninstead, standing alone with every link flush beneath it. `0`\nalways takes that split, and `false` lifts the cap so every\nchain hangs."
        }
      },
      "type": "object"
    },
    "ToggleOnly": {
      "description": "Sub-table shape for rules whose only knob is `enabled`.",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Toggles the rule on or off.",
          "type": "boolean"
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The resolved `prose` configuration, read from a `prose.toml` or\n`.config/prose.toml` document root, or a `pyproject.toml`\n`[tool.prose]` table.\n\n`code_line_length` defaults to `Some(88)`. `docstring_line_length`\ndefaults to `Some(76)`. `import_line_length` defaults to `Some(120)`,\nfalling back to `code_line_length` when `false`.\n`docstring_structured_policy` defaults to `CodeLineLength`.\n`imports.first_party` defaults to empty. `report_unstable_output`\ndefaults to `true`. `target_version` defaults to `None`. Per-rule\nsettings live under `rules`.",
  "properties": {
    "cache": {
      "$ref": "#/$defs/CacheConfig",
      "default": {
        "enabled": true,
        "max-size-mib": 100
      }
    },
    "code-line-length": {
      "default": 88,
      "description": "The line budget every length-aware rule honors.",
      "format": "uint",
      "minimum": 1,
      "type": [
        "integer",
        "null"
      ]
    },
    "docstring-line-length": {
      "default": 76,
      "description": "The description-prose budget for `wrap-docstrings`.",
      "format": "uint",
      "minimum": 1,
      "type": [
        "integer",
        "null"
      ]
    },
    "docstring-structured-policy": {
      "$ref": "#/$defs/DocstringStructuredPolicy",
      "default": "code-line-length",
      "description": "The budget structured docstring sections wrap to."
    },
    "import-line-length": {
      "anyOf": [
        {
          "format": "uint",
          "minimum": 1,
          "type": "integer"
        },
        {
          "const": false
        }
      ],
      "default": 120,
      "description": "The import-wrap budget for `reflow-imports`, falling back to\n`code-line-length` when `false`."
    },
    "imports": {
      "$ref": "#/$defs/ImportsConfig",
      "default": {
        "first-party": []
      }
    },
    "report-unstable-output": {
      "default": true,
      "description": "Reports a rewrite whose settle check names rules as a defect in\nProse, naming the reproducing subset and the invocation that\nreplays it. `false` lands the rewrite with no notice.",
      "type": "boolean"
    },
    "rules": {
      "$ref": "#/$defs/RuleConfigs",
      "default": {
        "align-colons": {
          "enabled": true,
          "max-shift": 16
        },
        "align-comments": {
          "enabled": true,
          "max-shift": 16
        },
        "align-comparisons": {
          "enabled": true,
          "max-shift": 16
        },
        "align-equals": {
          "enabled": true,
          "max-shift": 16
        },
        "align-imports": {
          "enabled": true,
          "max-shift": 16
        },
        "align-match-case": {
          "enabled": true,
          "max-shift": 16
        },
        "alphabetize-siblings": {
          "enabled": true,
          "group-methods": true,
          "sort-definitions": true,
          "sort-dict-keys": true,
          "sort-docstring-entries": true,
          "sort-dunder-lists": true
        },
        "band-constants": {
          "enabled": true,
          "group-subcategories": true,
          "max-tiers": 2
        },
        "bare-imports": {
          "allow": [],
          "enabled": true,
          "exempt-aliased": true,
          "max-attributes": 4
        },
        "expand-docstrings": {
          "enabled": true
        },
        "frame-docstrings": {
          "enabled": true
        },
        "group-imports": {
          "enabled": true
        },
        "line-overflow": {
          "enabled": true,
          "suggest-string-splits": true
        },
        "miscased-constants": {
          "allow-pattern": "",
          "enabled": true
        },
        "modernize-annotations": {
          "enabled": true,
          "rewrite-generics": true,
          "rewrite-unions": true
        },
        "normalize-comment-spacing": {
          "enabled": true
        },
        "normalize-comparisons": {
          "enabled": true,
          "rewrite-identity": true,
          "rewrite-negation": true,
          "rewrite-operand-order": true
        },
        "normalize-literals": {
          "enabled": true,
          "unify-numerics": true,
          "unify-prefixes": true,
          "unify-quotes": true
        },
        "prefer-fstring": {
          "enabled": true,
          "rewrite-percent": true,
          "rewrite-str-format": true
        },
        "prune-inert-imports": {
          "drop-duplicates": true,
          "drop-unreferenced": true,
          "enabled": true
        },
        "reassigned-constants": {
          "allow": [],
          "enabled": true
        },
        "reflow-calls": {
          "enabled": true,
          "max-args": 3
        },
        "reflow-collections": {
          "enabled": true,
          "explode": true,
          "keep-multiline-literals": true,
          "max-atomics": 8,
          "max-dict-entries": 3,
          "wrap-dict-entries": true
        },
        "reflow-imports": {
          "enabled": true,
          "merge-members": true,
          "split-multi-module": true
        },
        "reflow-signatures": {
          "enabled": true,
          "max-params": 4
        },
        "restated-types": {
          "enabled": true
        },
        "shed-backslash-continuations": {
          "enabled": true
        },
        "shed-parentheses": {
          "enabled": true
        },
        "shed-redundant-base": {
          "enabled": true
        },
        "shed-super-args": {
          "enabled": true
        },
        "signature-annotations": {
          "enabled": true
        },
        "simplify-comprehensions": {
          "enabled": true
        },
        "single-use-variables": {
          "allow-pattern": "^_",
          "enabled": true
        },
        "space-statements": {
          "enabled": true
        },
        "stack-adjacent-strings": {
          "enabled": true
        },
        "stack-method-chains": {
          "enabled": true,
          "max-links": 2,
          "max-shift": 16
        },
        "step-narration": {
          "enabled": true
        },
        "strip-none-return": {
          "enabled": true
        },
        "strip-stranded-padding": {
          "enabled": true
        },
        "strip-trailing-commas": {
          "enabled": true
        },
        "unsorted-positionals": {
          "enabled": true
        },
        "wrap-docstrings": {
          "enabled": true
        }
      }
    },
    "target-version": {
      "anyOf": [
        {
          "$ref": "#/$defs/PythonVersion"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The Python runtime the project ships to, read by the\nversion-gated rules."
    }
  },
  "title": "Config",
  "type": "object"
}

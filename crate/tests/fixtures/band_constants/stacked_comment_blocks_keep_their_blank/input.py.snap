import os

# the retry envelope the loader reads

# per-attempt ceiling, in milliseconds
ATTEMPT_MS = 250
RETRY_LIMIT = 3

MAX_ATTEMPTS = RETRY_LIMIT
TOTAL_BUDGET_MS = ATTEMPT_MS


def load(path):
    return os.stat(path)

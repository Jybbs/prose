def dispatch(kind, field):
    match kind:
        case "alpha":
            return {
                "comment_text" : "primary",
                "extra"        : True,
                "name"         : "alpha",
                "weight"       : 1
            }.get(field)
        case "beta":
            return {
                "comment_text" : "secondary",
                "extra"        : False,
                "name"         : "beta",
                "weight"       : 2
            }.get(field)
        case _: return None

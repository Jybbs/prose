class F:
    def __contains__(self, other):
        if not isinstance(other, self.__class__):
            raise TypeError(
                "unsupported operand type(s) for 'in': %r and %r" % (
                    type(
                        other
                    ).__qualname__, self.__class__.__qualname__)
            )
        return other._value_ & self._value_ == other._value_

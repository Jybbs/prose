{
  "extends"         : "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions" : {
    "noEmit" : true,
    "target" : "ESNext",
    "lib"    : ["ESNext", "DOM", "DOM.Iterable"],
    "types"  : ["node", "vite/client", "vitest/globals"]
  },
  "include"         : [
    "**/*.ts",
    "**/*.tsx",
    "../prototypes/**/*.ts",
    "../prototypes/**/*.tsx"
  ],
  "exclude"         : ["tests/wasm/**"]
}

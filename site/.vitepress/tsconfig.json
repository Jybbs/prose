{
  "extends"         : "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions" : {
    "noEmit" : true,
    "target" : "ESNext",
    "lib"    : ["ESNext", "DOM", "DOM.Iterable"],
    "types"  : ["node", "vite/client", "vitest/globals"]
  },
  "include"         : [
    "**/*.ts",
    "**/*.tsx",
    "../../tests/site/**/*.ts",
    "../../tests/site/**/*.tsx"
  ],
  "exclude"         : ["../../tests/site/wasm/**"]
}

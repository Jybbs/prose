---
import Default  from '@astrojs/starlight/components/Head.astro'
import { Font } from 'astro:assets'

import OverlayLayer      from './overlays/OverlayLayer.astro'
import { FONT_FAMILIES } from '../lib/tokens/fonts'
---

<Default><slot /></Default>
{FONT_FAMILIES.map(({ cssVariable }) => <Font cssVariable={cssVariable} />)}
{/* Script-only island, hoisted out of the head by Astro's bundling. */}
<OverlayLayer />

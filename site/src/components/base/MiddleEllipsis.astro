---
interface Props {
  tail ?: number
  text  : string
}

const { tail = 3, text } = Astro.props
---

<middle-ellipsis data-tail={tail} data-text={text}>{text}</middle-ellipsis>

<script>
  import { middleEllipsis } from '../../lib/shared/middle-ellipsis'
  import { remeasure }      from '../../lib/shared/dom/remeasure'

  class MiddleEllipsis extends HTMLElement {
    #observer: ResizeObserver | undefined

    connectedCallback(): void {
      this.#observer = remeasure(this, () => this.#fit())
    }

    disconnectedCallback(): void {
      this.#observer?.disconnect()
    }

    #fit(): void {
      const tail = Number(this.dataset.tail ?? 3)
      const text = this.dataset.text ?? ''
      const fits = (candidate: string): boolean => {
        this.textContent = candidate
        return this.scrollWidth <= this.clientWidth + 1
      }
      this.textContent = middleEllipsis(fits, tail, text)
    }
  }

  customElements.define('middle-ellipsis', MiddleEllipsis)
</script>

<style is:global>
  middle-ellipsis {
    display     : block;
    overflow    : hidden;
    white-space : nowrap;
    min-width   : 0;
  }
</style>

---
import '../../styles/mixins/folio.css'
import '../../styles/mixins/kicker.css'
import '../../styles/mixins/leader.css'
import './styles/editor-run-on-save.css'

import { getCollection } from 'astro:content'
import { Code }          from '@astrojs/starlight/components'

import Tool            from '../base/Tool.astro'
import { formatFolio } from '../../lib/shared/numerals'
import { required }    from '../../lib/shared/required'

const editors   = await getCollection('editorConfigs')
const toolNames = new Map((await getCollection('tools')).map(tool => [tool.id, tool.data.name]))

const nameOf = (id: string): string =>
  required(toolNames.get(id), `Editor "${id}" is not in the tools collection`)
---

<editor-run-on-save class="editor-card">
  <aside class="editor-card-index">
    <span class="kicker editor-card-edition">Editors · {formatFolio(editors.length)}</span>
    <ul class="editor-card-list" role="tablist">
      {editors.map((editor, i) => (
        <li>
          <button
            type="button"
            role="tab"
            class:list={['editor-card-row', { 'is-active': i === 0 }]}
            aria-selected={i === 0 ? 'true' : 'false'}
            data-slug={editor.id}
          >
            <span class="folio">№ {formatFolio(i + 1)}</span>
            <span class="tool-medallion editor-card-row-mark" aria-hidden="true"><Tool slug={editor.id} bare /></span>
            <em class="editor-card-row-name">{nameOf(editor.id)}</em>
            <span class="leader editor-card-row-leader" aria-hidden="true"></span>
          </button>
        </li>
      ))}
    </ul>
  </aside>

  <div class="editor-card-faces" aria-live="polite">
    {editors.map((editor, i) => (
      <section class="editor-card-face" data-slug={editor.id} hidden={i !== 0}>
        <header class="editor-card-face-head">
          <span class="kicker">{editor.data.caption}</span>
          <span class="editor-card-face-target">{editor.data.target}</span>
        </header>
        <div class="editor-card-face-code"><Code code={editor.data.code} lang={editor.data.language} /></div>
      </section>
    ))}
  </div>
</editor-run-on-save>

<script>
  import { defineTabSelectElement } from '../../lib/shared/dom/tab-select'

  // Turns the index rows into tabs over the per-editor config faces.
  defineTabSelectElement('editor-run-on-save', {
    events : ['click'],
    key    : 'slug',
    panels : '.editor-card-face',
    tabs   : '.editor-card-row'
  })
</script>

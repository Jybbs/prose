---
import './az-index.css'

import { getCollection } from 'astro:content'

import { renderInline }                               from '../../lib/markdown/render'
import { DOMAIN_LABELS, TOKEN_DOMAINS, tokenSortKey } from '../../lib/reference/token-domains'
import type { TokenDomain }                           from '../../lib/reference/token-domains'

const index = await getCollection('tokenIndex')

const sections = await Promise.all(TOKEN_DOMAINS.map(async domain => {
  const tokens = index.find(entry => entry.id === domain)?.data ?? []
  return {
    domain,
    label  : DOMAIN_LABELS[domain],
    tokens : await Promise.all(
      [...tokens]
        .sort((a, b) => tokenSortKey(a.key).localeCompare(tokenSortKey(b.key)))
        .map(async token => ({
          blurbHtml : await renderInline(token.blurb),
          href      : token.href,
          key       : token.key
        }))
    )
  }
}))

const tabs: TokenDomain[] = [...TOKEN_DOMAINS].sort()
---

<az-index class="az-index-stage">
  <nav class="az-index-tabs" role="tablist" aria-label="Domain tabs">
    <button type="button" role="tab" aria-selected="true" class="az-index-tab is-active">All</button>
    {tabs.map(domain => (
      <button
        type="button"
        role="tab"
        aria-selected="false"
        class="az-index-tab"
        data-domain={domain}
      >{DOMAIN_LABELS[domain]}</button>
    ))}
  </nav>

  <div class="az-index-float-wrap">
    <div class="az-index-float-keys-wrap" data-dim="false">
      {sections.map(({ domain, label, tokens }) => (
        <section class="az-index-section" data-domain={domain}>
          <header class="az-index-section-head">
            <span class="kicker az-index-section-folio">{label}</span>
            <span class="az-index-section-count">{tokens.length} entries</span>
          </header>
          <ul class="az-index-keys">
            {tokens.map(token => (
              <li class="az-index-key" data-domain={domain}>
                <a
                  class="az-index-key-btn"
                  href={token.href}
                  data-blurb={token.blurbHtml}
                  data-key={token.key}
                  data-label={label}
                >{token.key}</a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</az-index>

<script>
  import { attachHoverOverlay } from '../../lib/overlay/hover'

  // The domain tabs filter the key sections, and the hover overlay floats
  // each key's detail card beside its column, the keys behind it dimming and
  // the held key marking itself current while the card stays open.
  class AzIndexElement extends HTMLElement {
    connectedCallback(): void {
      for (const tab of this.querySelectorAll<HTMLButtonElement>('.az-index-tab')) {
        tab.addEventListener('click', () => this.#select(tab))
      }
    }

    #select(tab: HTMLButtonElement): void {
      const domain = tab.dataset.domain
      for (const sibling of this.querySelectorAll('.az-index-tab')) {
        sibling.classList.toggle('is-active', sibling === tab)
        sibling.setAttribute('aria-selected', String(sibling === tab))
      }
      for (const section of this.querySelectorAll<HTMLElement>('.az-index-section')) {
        section.hidden = domain !== undefined && section.dataset.domain !== domain
      }
    }
  }

  function detail(anchor: HTMLElement): HTMLElement {
    const card = document.createElement('aside')
    card.className = 'az-index-detail'
    card.dataset.domain = anchor.closest<HTMLElement>('.az-index-key')?.dataset.domain ?? ''

    const banner = document.createElement('header')
    banner.className = 'az-index-detail-banner'
    const kicker = document.createElement('span')
    kicker.className   = 'az-index-detail-kicker'
    kicker.textContent = anchor.dataset.label ?? ''
    banner.append(kicker)

    const body = document.createElement('div')
    body.className = 'az-index-detail-body'
    const key = document.createElement('code')
    key.className   = 'az-index-detail-key'
    key.textContent = anchor.dataset.key ?? ''
    const blurb = document.createElement('p')
    blurb.className = 'az-index-detail-blurb'
    blurb.innerHTML = anchor.dataset.blurb ?? ''
    const href = document.createElement('a')
    href.className   = 'az-index-detail-href'
    href.href        = anchor.getAttribute('href') ?? ''
    href.textContent = `→ ${anchor.getAttribute('href') ?? ''}`
    body.append(key, blurb, href)

    card.append(banner, body)
    return card
  }

  function dim(anchor: HTMLElement, dimmed: boolean): void {
    const wrap = anchor.closest('az-index')?.querySelector<HTMLElement>('.az-index-float-keys-wrap')
    if (wrap) wrap.dataset.dim = String(dimmed)
  }

  attachHoverOverlay({
    gapPx       : 14,
    hideDelayMs : 220,
    onClose     : anchor => {
      anchor.removeAttribute('aria-current')
      dim(anchor, false)
    },
    onOpen      : anchor => {
      anchor.setAttribute('aria-current', 'true')
      dim(anchor, true)
    },
    panelClass  : 'az-index-pop',
    placement   : 'right-start',
    render      : detail,
    selector    : '.az-index-key-btn'
  })

  customElements.define('az-index', AzIndexElement)
</script>

---
import './run-summary.css'

import type { RenderedLine } from '../../lib/reference/run-summary'

interface Props {
  line: RenderedLine
}

const { line } = Astro.props
---

<div class="run-summary">
  <div class="run-summary-bar">
    {[1, 2, 3].map(() => <span class="run-summary-dot" aria-hidden="true"></span>)}
    <span class="run-summary-title" aria-hidden="true">prose</span>
    <slot name="bar" />
  </div>
  <div class="run-summary-body">
    <div class="run-summary-line">
      {line.anchor !== null && (
        <span class="run-summary-anchor" data-ube={line.anchorUbe || undefined} aria-hidden="true">
          {line.anchor}
        </span>
      )}
      <span class="run-summary-msg" data-tint={line.countTint ?? undefined}>{line.text}</span>
    </div>
  </div>
</div>

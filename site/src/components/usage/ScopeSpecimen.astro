---
import '../../styles/mixins/pip.css'
import './styles/scope-specimen.css'

import { getCollection } from 'astro:content'

import { required }                               from '../../lib/shared/required'
import { directiveHref, SCOPE_META, SCOPE_ORDER } from '../../lib/suppression/scope-meta'
import type { ScopeKey }                          from '../../lib/suppression/scope-meta'

interface SpecimenLine {
  bracket : 'open' | 'close' | 'mid' | 'solo' | null
  scope   : ScopeKey | null
  text    : string
}

const lines: SpecimenLine[] = [
  { bracket : 'open',  scope : 'file',  text : '# prose: off' },
  { bracket : 'mid',   scope : 'file',  text : '' },
  { bracket : 'mid',   scope : 'file',  text : 'from collections import OrderedDict' },
  { bracket : 'mid',   scope : 'file',  text : '' },
  { bracket : 'mid',   scope : 'file',  text : 'def render(rows):' },
  { bracket : 'open',  scope : 'block', text : '    # fmt: off' },
  { bracket : 'mid',   scope : 'block', text : '    grid = [[1, 0, 0, 0],' },
  { bracket : 'mid',   scope : 'block', text : '            [0, 1, 0, 0],' },
  { bracket : 'mid',   scope : 'block', text : '            [0, 0, 1, 0],' },
  { bracket : 'mid',   scope : 'block', text : '            [0, 0, 0, 1]]' },
  { bracket : 'close', scope : 'block', text : '    # fmt: on' },
  { bracket : 'mid',   scope : 'file',  text : '' },
  { bracket : 'solo',  scope : 'line',  text : '    out = build(rows)  # fmt: skip' },
  { bracket : 'solo',  scope : 'line',  text : '    log(out)  # prose: ignore[<rule>]' },
  { bracket : 'mid',   scope : 'file',  text : '' },
  { bracket : 'open',  scope : 'dict',  text : '    STAGES = {  # prose: keep' },
  { bracket : 'mid',   scope : 'dict',  text : '        "fetch"    : fetch,' },
  { bracket : 'mid',   scope : 'dict',  text : '        "parse"    : parse,' },
  { bracket : 'mid',   scope : 'dict',  text : '        "validate" : validate,' },
  { bracket : 'mid',   scope : 'dict',  text : '        "render"   : render,' },
  { bracket : 'close', scope : 'dict',  text : '    }' },
  { bracket : 'close', scope : 'file',  text : '' }
]

const LEGEND_IDS = [
  'prose-off', 'fmt-off', 'fmt-skip', 'prose-skip-rules', 'prose-ignore-rules', 'prose-keep'
]

const byId = new Map((await getCollection('directives')).map(entry => [entry.id, entry.data]))

const legendEntry = (id: string): { directive: string, href: string, scope: ScopeKey } => {
  const data   = required(
    byId.get(id),
    `ScopeSpecimen legend id "${id}" is not in the directives collection`
  )
  const closer = data.pairId === undefined ? undefined : byId.get(data.pairId)
  return {
    directive : closer === undefined ? data.form : `${data.form} … ${closer.form}`,
    href      : directiveHref(data.scope),
    scope     : data.scope
  }
}

const entries = LEGEND_IDS.map(legendEntry)

const legend = SCOPE_ORDER.map(scope => ({
  items : entries.filter(entry => entry.scope === scope),
  scope
}))
---

<div class="scope-specimen">
  <pre class="scope-specimen-source"><code>{lines.map((line, idx) => (
    <span class="scope-specimen-line" data-scope={line.scope} data-bracket={line.bracket}><span class="scope-specimen-gutter" aria-hidden="true">{String(idx + 1).padStart(2, ' ')}</span><span class="scope-specimen-bracket" aria-hidden="true"></span><span class="scope-specimen-code">{line.text === '' ? ' ' : line.text}</span></span>
  ))}</code></pre>

  <ul class="scope-specimen-legend">
    {legend.map(band => (
      <li class="scope-specimen-legend-row" data-scope={band.scope}>
        <span class="scope-specimen-legend-marker" aria-hidden="true">
          <span class="scope-specimen-legend-pip">{SCOPE_META[band.scope].pip}</span>
          <span class="scope-specimen-legend-name">{SCOPE_META[band.scope].label}</span>
        </span>
        <ul class="scope-specimen-legend-directives">
          {band.items.map(d => (
            <li class="scope-specimen-legend-directive">
              <a class="body-link" href={d.href}><code>{d.directive}</code></a>
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ul>
</div>

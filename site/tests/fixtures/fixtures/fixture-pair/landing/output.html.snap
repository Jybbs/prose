<div class="fixture-pair fixture-pair-landing">
  <div class="panel panel-clip fixture-pair-side">
    <div class="fixture-pair-label" data-side="before">
      <span class="fixture-pair-dot" data-side="before"></span><span>Before</span>
    </div>
    <div class="fixture-pair-code">
      <div class="expressive-code">
        <link rel="stylesheet" href="/_astro/ec.u6yl4.css" />
        <script type="module" src="/_astro/ec.0vx5m.js"></script>
        <figure class="frame not-content">
          <figcaption class="header"></figcaption>
          <pre
            data-language="python"
          ><code><div class="ec-line"><div class="code"><span style="--0:#E1E4E8;--1:#24292E">x </span><span style="--0:#F97583;--1:#B7313E">=</span><span style="--0:#E1E4E8;--1:#24292E"> </span><span style="--0:#79B8FF;--1:#005CC5">1</span></div></div></code></pre>
          <div class="copy">
            <div aria-live="polite"></div>
            <button title="Copy to clipboard" data-copied="Copied!" data-code="x = 1">
              <div></div>
            </button>
          </div>
        </figure>
      </div>
    </div>
  </div>
  <div class="fixture-pair-arrow" aria-hidden="true">→</div>
  <div class="panel panel-clip fixture-pair-side">
    <div class="fixture-pair-label" data-side="after">
      <span class="fixture-pair-dot" data-side="after"></span><span>After</span>
    </div>
    <div class="fixture-pair-code">
      <div class="expressive-code">
        <figure class="frame not-content">
          <figcaption class="header"></figcaption>
          <pre
            data-language="python"
          ><code><div class="ec-line"><div class="code"><span style="--0:#E1E4E8;--1:#24292E">x </span><span style="--0:#F97583;--1:#B7313E">=</span><span style="--0:#E1E4E8;--1:#24292E"> </span><span style="--0:#79B8FF;--1:#005CC5">1</span></div></div></code></pre>
          <div class="copy">
            <div aria-live="polite"></div>
            <button title="Copy to clipboard" data-copied="Copied!" data-code="x = 1">
              <div></div>
            </button>
          </div>
        </figure>
      </div>
    </div>
  </div>
</div>

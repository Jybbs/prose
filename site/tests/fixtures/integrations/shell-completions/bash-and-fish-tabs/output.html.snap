<shell-completions class="shell-card"
  ><div class="shell-card-stack" role="tablist" aria-label="Shell completion targets">
    <button
      type="button"
      role="tab"
      class="shell-card-tab is-active"
      aria-selected="true"
      data-slug="bash"
      style="--idx: 0"
    >
      <span class="tool-medallion shell-card-tab-mark" aria-hidden="true"
        ><a
          class="tool-mark tool-bare"
          href="https://gnu.org/bash"
          title="Bash"
          target="_blank"
          rel="noopener"
          ><svg
            width="0.88em"
            height="1em"
            class="tool-mark-icon"
            aria-hidden="true"
            data-icon="logos:bash-icon"
          >
            <symbol id="ai:logos:bash-icon" viewBox="0 0 224 256">
              <path
                fill="#fff"
                d="M207.953 52.162L127.317 4.287a30.37 30.37 0 0 0-31.114 0L15.55 52.162A32.17 32.17 0 0 0 0 79.869v95.734a32.17 32.17 0 0 0 15.55 27.691l80.636 47.859a30.39 30.39 0 0 0 31.115 0l80.636-47.859a32.17 32.17 0 0 0 15.566-27.707V79.869a32.17 32.17 0 0 0-15.55-27.707"
              />

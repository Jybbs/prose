              />
              <path
                fill="#3ab14a"
                d="m187.007 185.06l-20.086 12.013a1.47 1.47 0 0 0-.92 1.308v5.28c0 .646.435.904.968.597l20.394-12.4a1.62 1.62 0 0 0 .613-1.615v-4.634c-.016-.598-.484-.856-.969-.55"
              />
              <path
                fill="#fff"
                d="M144.263 140.832c.646-.323 1.179 0 1.195.92l.064 7.008a12.9 12.9 0 0 1 7.718-.937c.501.13.71.808.517 1.615l-1.534 6.152a2.65 2.65 0 0 1-.694 1.227a1.6 1.6 0 0 1-.404.29a.92.92 0 0 1-.597.098a10.24 10.24 0 0 0-7.444 1.194a9.35 9.35 0 0 0-5.506 8.284c0 3.229 1.615 4.117 7.25 4.214c7.444.13 10.673 3.375 10.754 10.883a26.69 26.69 0 0 1-9.882 20.135l.13 6.878a2.52 2.52 0 0 1-1.18 2.1l-4.068 2.34c-.646.323-1.18 0-1.195-.904v-6.765c-3.488 1.453-7.024 1.792-9.285.888c-.42-.162-.613-.791-.436-1.518l1.47-6.216a2.6 2.6 0 0 1 .726-1.292q.174-.166.388-.275a.8.8 0 0 1 .662 0c2.878.78 5.948.392 8.541-1.081a11.17 11.17 0 0 0 6.314-9.688c0-3.488-1.922-4.941-6.459-4.974c-5.861 0-11.303-1.13-11.416-9.688a25.03 25.03 0 0 1 9.462-19.15l-.29-7.04a2.5 2.5 0 0 1 1.178-2.13z"
              />
            </symbol>
            <use href="#ai:logos:bash-icon"></use></svg></a></span
      ><em class="shell-card-tab-name">Bash</em></button
    ><button
      type="button"
      role="tab"
      class="shell-card-tab"
      aria-selected="false"
      data-slug="fish"
      style="--idx: 1"
    >
      <span class="tool-medallion shell-card-tab-mark" aria-hidden="true"
        ><a
          class="tool-mark tool-bare"
          href="https://fishshell.com"
          title="Fish"
          target="_blank"
          rel="noopener"
          ><svg
            width="1em"
            height="1em"
            class="tool-mark-icon"
            aria-hidden="true"
            data-icon="simple-icons:fishshell"
          >
            <symbol id="ai:simple-icons:fishshell" viewBox="0 0 24 24">
              <path
                fill="currentColor"
                d="m19.164 9.228l-3.016 2.688v.527l3.016 2.688v-1.228l-1.936-1.723l1.936-1.724zm-6.658.046v1.208l1.905 1.696l-1.905 1.695v1.209l2.968-2.645v-.518zM9.781 7.847a6.5 6.5 0 0 0-2.038-.335q-1.008 0-2.03.335a9.2 9.2 0 0 0-2.088 1.017v.723q1.035-.6 2.06-.897a7.4 7.4 0 0 1 2.058-.296q1.026 0 2.052.296a9.5 9.5 0 0 1 2.075.897v-.723a9.2 9.2 0 0 0-2.09-1.017m.014 7.78a7.4 7.4 0 0 1-2.052.296a7.4 7.4 0 0 1-2.057-.296a9.2 9.2 0 0 1-2.061-.897v.723a9.2 9.2 0 0 0 2.088 1.017a6.5 6.5 0 0 0 2.03.335q1.017 0 2.038-.335a9.2 9.2 0 0 0 2.089-1.017v-.723q-1.05.6-2.075.897m.602-11.23h-.51L7.28 6.92h1.19l1.672-1.62l1.671 1.62h1.191l-2.607-2.525m-2.965 13.68v-.824H6.427v.825l.786 1.527h.614zM4.127 10.95v1.216H5.13V10.95zm-1.16-1.695L0 11.901v.518l2.967 2.645v-1.208L1.063 12.16l1.904-1.695zm20.68 3.28q-.352-.45-1.017-.626q.593-.154.902-.525q.31-.37.31-.926q0-.819-.59-1.314t-1.575-.495q-.33 0-.758.073q-.427.072-.974.217v.84q.47-.18.9-.27a4 4 0 0 1 .832-.091q.605 0 .933.278q.327.277.328.798q0 .492-.353.768t-.98.276h-.697v.75h.696q.687 0 1.09.346q.402.345.402.934q0 .637-.402.976q-.403.339-1.153.339a3.6 3.6 0 0 1-.89-.117a4.4 4.4 0 0 1-.91-.358v.909a6 6 0 0 0 .95.249q.484.085.95.085q1.107 0 1.733-.53q.626-.532.626-1.463q0-.673-.353-1.123"
              />
            </symbol>
            <use href="#ai:simple-icons:fishshell"></use></svg></a></span
      ><em class="shell-card-tab-name">Fish</em>
    </button>
    <article class="shell-card-modal" data-slug="bash">
      <header class="shell-card-modal-head">
        <span class="tool-medallion shell-card-modal-mark" aria-hidden="true"
          ><a
            class="tool-mark tool-bare"
            href="https://gnu.org/bash"
            title="Bash"
            target="_blank"
            rel="noopener"
            ><svg
              width="0.88em"
              height="1em"
              viewBox="0 0 224 256"
              class="tool-mark-icon"
              aria-hidden="true"
              data-icon="logos:bash-icon"
            >
              <use href="#ai:logos:bash-icon"></use></svg></a></span
        ><span class="kicker">bash_completion.d</span>
      </header>
      <div class="shell-card-modal-body">
        <div class="shell-card-modal-code">
          <div class="expressive-code">
            <link rel="stylesheet" href="/_astro/ec.u6yl4.css" />
            <script type="module" src="/_astro/ec.0vx5m.js"></script>
            <figure class="frame is-terminal not-content">
              <figcaption class="header">
                <span class="title"></span><span class="sr-only">Terminal window</span>
              </figcaption>
              <pre
                data-language="bash"
              ><code><div class="ec-line"><div class="code"><span style="--0:#B392F0;--1:#6F42C1">prose</span><span style="--0:#E1E4E8;--1:#24292E"> </span><span style="--0:#9ECBFF;--1:#032F62">completions</span><span style="--0:#E1E4E8;--1:#24292E"> </span><span style="--0:#9ECBFF;--1:#032F62">bash</span></div></div></code></pre>
              <div class="copy">
                <div aria-live="polite"></div>
                <button
                  title="Copy to clipboard"
                  data-copied="Copied!"
                  data-code="prose completions bash"
                >
                  <div></div>
                </button>
              </div>
            </figure>
          </div>
        </div>
        <p class="shell-card-modal-note">bash note</p>
      </div>
    </article>
    <article class="shell-card-modal" data-slug="fish" hidden>
      <header class="shell-card-modal-head">
        <span class="tool-medallion shell-card-modal-mark" aria-hidden="true"
          ><a
            class="tool-mark tool-bare"
            href="https://fishshell.com"
            title="Fish"
            target="_blank"
            rel="noopener"
            ><svg
              width="1em"
              height="1em"
              viewBox="0 0 24 24"
              class="tool-mark-icon"
              aria-hidden="true"
              data-icon="simple-icons:fishshell"
            >
              <use href="#ai:simple-icons:fishshell"></use></svg></a></span
        ><span class="kicker">completions dir</span>
      </header>
      <div class="shell-card-modal-body">
        <div class="shell-card-modal-code">
          <div class="expressive-code">
            <figure class="frame is-terminal not-content">
              <figcaption class="header">
                <span class="title"></span><span class="sr-only">Terminal window</span>
              </figcaption>
              <pre
                data-language="fish"
              ><code><div class="ec-line"><div class="code"><span style="--0:#79B8FF;--1:#005CC5">prose</span><span style="--0:#E1E4E8;--1:#24292E"> completions fish</span></div></div></code></pre>
              <div class="copy">
                <div aria-live="polite"></div>
                <button
                  title="Copy to clipboard"
                  data-copied="Copied!"
                  data-code="prose completions fish"
                >
                  <div></div>
                </button>
              </div>
            </figure>
          </div>
        </div>
        <p class="shell-card-modal-note">fish note</p>
      </div>
    </article>
  </div></shell-completions
>
<script
  type="module"
  src="src/components/integrations/ShellCompletions.astro?astro&type=script&index=0&lang.ts"
></script>

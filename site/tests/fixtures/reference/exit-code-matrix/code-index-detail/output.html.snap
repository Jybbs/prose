<exit-code-matrix class="exit-codes-spread"
  ><nav class="exit-codes-index" aria-label="Exit codes">
    <button type="button" class="exit-code-index-row active" data-exit-code="0">
      <span class="exit-code-index-num">0</span><span class="exit-code-index-label">Clean</span
      ><span class="leader" aria-hidden="true"></span
      ><span class="exit-code-index-mark" aria-hidden="true"></span></button
    ><button type="button" class="exit-code-index-row" data-exit-code="2">
      <span class="exit-code-index-num">2</span
      ><span class="exit-code-index-label">Diagnostics</span
      ><span class="leader" aria-hidden="true"></span
      ><span class="exit-code-index-mark" aria-hidden="true"></span>
    </button>
  </nav>
  <article class="exit-code-entry" data-exit-code="0" aria-live="polite">
    <header class="exit-code-entry-head">
      <span class="exit-code-entry-numeral" aria-hidden="true">0</span
      ><span class="exit-code-entry-label">Clean</span>
    </header>
    <p class="exit-code-entry-summary">No findings</p>
    <ul class="exit-code-entry-details">
      <li>All good</li>
    </ul>
  </article>
  <article class="exit-code-entry" data-exit-code="2" aria-live="polite" hidden>
    <header class="exit-code-entry-head">
      <span class="exit-code-entry-numeral" aria-hidden="true">2</span
      ><span class="exit-code-entry-label">Diagnostics</span>
    </header>
    <p class="exit-code-entry-summary">Findings remain</p>
    <ul class="exit-code-entry-details">
      <li>A finding remains</li>
      <li>Another</li>
    </ul>
  </article></exit-code-matrix
>
<script
  type="module"
  src="src/components/reference/ExitCodeMatrix.astro?astro&type=script&index=0&lang.ts"
></script>

{
  "extends"         : "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions" : {
    "noEmit" : true,
    "target" : "ESNext",
    "lib"    : ["ESNext", "DOM", "DOM.Iterable"],
    "types"  : ["node", "vite/client", "vitest/globals"]
  },
  "contentMappers"  : [
    { "package": "@vue/content-mapper", "extensions": [".vue"], "options": { "dataAttributes": ["aria-*", "data-*"], "target": 3.5 } }
  ],
  "include"         : [
    ".vitepress/**/*.ts",
    ".vitepress/**/*.tsx",
    ".vitepress/**/*.vue",
    "prototypes/**/*.ts",
    "prototypes/**/*.vue",
    "vitest.config.ts",
    "knip.ts"
  ],
  "exclude"         : [".vitepress/tests/wasm/**"]
}

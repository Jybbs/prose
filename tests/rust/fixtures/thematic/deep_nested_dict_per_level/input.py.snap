DEPLOY = {
    "owner"   : "core",
    "region"  : "us-east",
    "stage"   : "prod",
    "version" : 12,

    "services": {
        "api"     : {
            "timeout"   : 30,
            "retries"   : 3,
            "port"      : 8080,
            "endpoints" : {
                "health"    : "/health",
                "metrics"   : "/metrics",
                "readiness" : "/ready",
                "version"   : "/v"
            },
            "headers"   : {
                "trace_id"   : "x-trace",
                "user_agent" : "deploy/1",
                "request_id" : "x-req"
            }
        },
        "worker"  : {"concurrency": 8, "queue": "tasks"},
        "gateway" : {
            "timeout"    : 5,
            "rate_limit" : 1000,
            "upstream"   : {"primary": "api.internal", "fallback": "api.backup"}
        }
    },

    "telemetry": {
        "sink"     : "datadog",
        "interval" : 30,
        "logs"     : {
            "level"        : "info",
            "format"       : "json",
            "destinations" : {
                "file"        : "/var/log/app",
                "stdout"      : True,
                "syslog"      : False,
                "remote_sink" : "logserver"
            }
        }
    }
}
